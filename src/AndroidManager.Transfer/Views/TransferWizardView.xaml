<UserControl x:Class="AndroidManager.Transfer.Views.TransferWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AndroidManager.Transfer.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1000"
             Background="{DynamicResource Nexus.Background}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <vm:InverseBooleanConverter x:Key="InvertBool" />
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="WhatsApp Aktarım (Android → iPhone)" Style="{StaticResource Nexus.Text.H1}" />
            <TextBlock Text="Önce Android verisini PC'ye alın, ardından iPhone'u bağlayıp aktarın."
                       Style="{StaticResource Nexus.Text.Caption}" Opacity="0.85" Margin="0,4,0,0" />
        </StackPanel>

        <TabControl Grid.Row="1" SelectedIndex="{Binding WizardStep}">
            <!-- Step 1: Android -->
            <TabItem Header="1. Android">
                <ScrollViewer Style="{StaticResource NexusPageScroll}" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="720">
                        <Border Style="{StaticResource NexusCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Android'den Veri Çek" Style="{StaticResource Nexus.Text.H3}" Margin="0,0,0,8" />
                                <TextBlock TextWrapping="Wrap" Opacity="0.9" Margin="0,0,0,12">
                                    msgstore.db root ile veya ADB yedekleme ile alınır. Medya dosyaları şifresiz klasörden çekilir.
                                </TextBlock>
                                <CheckBox Content="Medya dosyalarını da indir (foto/video)" IsChecked="{Binding IncludeMedia}" Margin="0,4" />
                                <CheckBox Content="Root yoksa ADB yedeklemeyi dene (telefonda onay gerekir)" IsChecked="{Binding TryAdbBackup}" Margin="0,4" />
                                <CheckBox Content="ADB başarısız olursa legacy WhatsApp downgrade dene"
                                          IsChecked="{Binding TryDowngrade}" Margin="0,4" />
                                <TextBlock Text="{Binding LegacyApkHint}"
                                           Margin="0,4,0,4"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Nexus.Text.Caption}">
                                            <Setter Property="Opacity" Value="0.85" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LegacyApkMissing}" Value="True">
                                                    <Setter Property="Foreground" Value="#C62828" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Opacity" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding LegacyApkPath}" IsReadOnly="True"
                                             md:HintAssist.Hint="Legacy WhatsApp APK (2.21.x önerilir)"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                                    <Button Grid.Column="1" Margin="8,0,0,0"
                                            Command="{Binding BrowseLegacyApkCommand}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Legacy WhatsApp APK seç">
                                        <md:PackIcon Kind="FolderOpen" />
                                    </Button>
                                </Grid>
                                <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,8,0,0" Style="{StaticResource Nexus.Text.Caption}">
                                    Not: Telefondaki "Verilerimi yedekle" ADB onayıdır; Magisk Superuser (Shell) ayrı bir izindir. Güncel WhatsApp ADB yedeğe msgstore.db koymaz.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NexusCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Durum" Style="{StaticResource Nexus.Text.H3}" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding AndroidSummary}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SessionDirectory}" Style="{StaticResource Nexus.Text.Caption}"
                                           TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.75" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding ExtractAndroidCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"
                                    Style="{StaticResource NexusPrimaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="Download" Margin="0,0,8,0" />
                                    <TextBlock Text="Android Verisini PC'ye Al" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenSessionFolderCommand}" Margin="8,0,0,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}">
                                Klasörü Aç
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Step 2: iPhone -->
            <TabItem Header="2. iPhone">
                <ScrollViewer Style="{StaticResource NexusPageScroll}" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="720">
                        <Border Style="{StaticResource NexusCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="iPhone Bağlantısı" Style="{StaticResource Nexus.Text.H3}" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding IosToolsHint}" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,8" />
                                <ComboBox ItemsSource="{Binding IosDevicesList}"
                                          SelectedItem="{Binding SelectedIosDevice}"
                                          DisplayMemberPath="DeviceName"
                                          md:HintAssist.Hint="Bağlı iPhone"
                                          Margin="0,0,0,8" />
                                <Button Command="{Binding RefreshIosDevicesCommand}"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource MaterialDesignOutlinedButton}">
                                    iPhone'ları Yenile
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NexusCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Aktarım" Style="{StaticResource Nexus.Text.H3}" Margin="0,0,0,8" />
                                <CheckBox Content="Hazır yedeği iPhone'a otomatik geri yükle" IsChecked="{Binding AutoRestore}" Margin="0,4" />
                                <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,8,0,0">
                                    iPhone'da WhatsApp kurulu olmalı. İşlem öncesi mevcut sohbetlerinizi yedekleyin.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Button Command="{Binding InjectToIphoneCommand}"
                                Style="{StaticResource NexusPrimaryButton}"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="CellphoneArrowDown" Margin="0,0,8,0" />
                                <TextBlock Text="iPhone'a Aktar" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Step 3: Saved sessions -->
            <TabItem Header="Kayıtlı Oturumlar">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox ItemsSource="{Binding SavedSessions}"
                             SelectedItem="{Binding SelectedSession}"
                             DisplayMemberPath="SessionDirectory" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Command="{Binding LoadSavedSessionsCommand}" Content="Yenile" Margin="0,0,8,0" />
                        <Button Command="{Binding UseSelectedSessionCommand}" Content="Bu Oturumu Kullan"
                                Style="{StaticResource NexusPrimaryButton}" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Step 4: Done -->
            <TabItem Header="Tamamlandı">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                    <md:PackIcon Kind="CheckCircle" Width="64" Height="64" HorizontalAlignment="Center"
                                 Foreground="{DynamicResource Nexus.Accent}" />
                    <TextBlock Text="{Binding StatusMessage}" TextAlignment="Center"
                               Style="{StaticResource Nexus.Text.H2}" Margin="0,16,0,8" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DetailMessage}" TextAlignment="Center"
                               Style="{StaticResource Nexus.Text.Caption}" TextWrapping="Wrap" Opacity="0.85" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Style="{StaticResource NexusCard}" Margin="0,12,0,0"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="6" Margin="0,8,0,0" />
                <Button Command="{Binding CancelJobCommand}" Content="İptal" HorizontalAlignment="Right"
                        Margin="0,8,0,0" Style="{StaticResource MaterialDesignFlatButton}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
