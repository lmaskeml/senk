<Window x:Class="AndroidManager.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:AndroidManager.Shell.ViewModels"
        Title="SeND ANDROID MANAGER"
        Height="820"
        Width="1280"
        MinHeight="640"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource Nexus.Background}"
        BorderBrush="{DynamicResource Nexus.Background}"
        TextElement.Foreground="{DynamicResource Nexus.TextPrimary}"
        TextElement.FontFamily="{DynamicResource Nexus.Font}"
        TextElement.FontSize="{DynamicResource GlobalFontSize}"
        TextElement.FontWeight="Normal"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        StateChanged="OnWindowStateChanged"
        SourceInitialized="OnSourceInitialized">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <vm:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis" />
        <!-- Sidebar-local: force readable light ink on dark chrome -->
        <Style x:Key="SidebarCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Nexus.SidebarCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Nexus.SidebarCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Nexus.RadiusCard}" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="SidebarText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Nexus.Font}" />
            <Setter Property="Foreground" Value="{DynamicResource Nexus.SidebarText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>
        <Style x:Key="SidebarTextMuted" TargetType="TextBlock" BasedOn="{StaticResource SidebarText}">
            <Setter Property="Foreground" Value="{DynamicResource Nexus.SidebarTextMuted}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style x:Key="SidebarRefreshButton" TargetType="Button" BasedOn="{StaticResource NexusSecondaryButton}">
            <Setter Property="Foreground" Value="{DynamicResource Nexus.SidebarText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Nexus.SidebarCardBorder}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Nexus.Background}"
                BorderBrush="{DynamicResource Nexus.Border}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource NexusCaptionButton}"
                            Click="Minimize_Click"
                            ToolTip="Küçült"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <materialDesign:PackIcon Kind="WindowMinimize" Width="14" Height="14"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource NexusCaptionButton}"
                            Click="Maximize_Click"
                            ToolTip="Büyüt"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <materialDesign:PackIcon x:Name="MaximizeIcon" Kind="WindowMaximize" Width="14" Height="14"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource NexusCaptionCloseButton}"
                            Click="Close_Click"
                            ToolTip="Kapat"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <materialDesign:PackIcon Kind="WindowClose" Width="14" Height="14"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,12,0">
                    <Image Source="pack://application:,,,/Assets/app.png"
                           Width="16" Height="16"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="SeND ANDROID MANAGER"
                               Style="{StaticResource Nexus.Text.H3}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                    <TextBlock Text="{Binding CurrentPageTitle}"
                               Style="{StaticResource Nexus.Text.Caption}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               Opacity="0.9" />
                </StackPanel>
            </DockPanel>
        </Border>

        <materialDesign:DialogHost Grid.Row="1" Identifier="RootDialog">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="248" MinWidth="72" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Nexus Sidebar: always dark rail + light text -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Nexus.Sidebar}"
                    ClipToBounds="True"
                    TextElement.Foreground="{DynamicResource Nexus.SidebarText}">
                <DockPanel LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" Margin="16,16,12,8" LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource SidebarRefreshButton}"
                                Command="{Binding ToggleSidebarCommand}"
                                ToolTip="Kenar çubuğunu daralt / genişlet"
                                Padding="6"
                                Width="32" Height="32">
                            <materialDesign:PackIcon Kind="Menu"
                                                     Width="18" Height="18"
                                                     Foreground="{DynamicResource Nexus.SidebarText}" />
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="pack://application:,,,/Assets/app.png"
                                       Width="20" Height="20"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="SeND"
                                           Style="{StaticResource SidebarTextMuted}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="ANDROID MANAGER"
                                       Style="{StaticResource SidebarText}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <Border DockPanel.Dock="Top"
                            Style="{StaticResource SidebarCard}"
                            Margin="12,4,12,8"
                            TextElement.Foreground="{DynamicResource Nexus.SidebarText}">
                        <StackPanel>
                            <TextBlock Text="CİHAZ"
                                       Style="{StaticResource SidebarTextMuted}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8" />
                            <ComboBox ItemsSource="{Binding ConnectedDevices}"
                                      SelectedItem="{Binding SelectedDevice}"
                                      Style="{StaticResource SidebarDeviceComboBox}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Serial}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Model}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Model}" Value="">
                                                            <Setter Property="Text" Value="{Binding Serial}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding DeviceInfo.Model, FallbackValue=Cihaz yok}"
                                       Style="{StaticResource SidebarText}"
                                       FontSize="15"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,10,0,2"
                                       ToolTip="{Binding DeviceInfo.Model}" />
                            <TextBlock Text="{Binding SelectedDevice.Serial, FallbackValue=—}"
                                       Style="{StaticResource SidebarTextMuted}"
                                       FontFamily="{DynamicResource Nexus.FontMono}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SelectedDevice.Serial}" />
                            <DockPanel Margin="0,10,0,0">
                                <Border DockPanel.Dock="Left"
                                        Background="#3322C55E"
                                        CornerRadius="999"
                                        Padding="10,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Margin="0,0,6,0"
                                                 Fill="{DynamicResource Nexus.Success}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ConnectionStatusLabel}"
                                                   Foreground="{DynamicResource Nexus.Success}"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <TextBlock DockPanel.Dock="Right"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource SidebarText}"
                                           FontSize="12"
                                           Text="{Binding DeviceInfo.Battery.Level, StringFormat={}{0}%, FallbackValue=—}" />
                            </DockPanel>
                            <TextBlock Text="Wi‑Fi ADB"
                                       Style="{StaticResource SidebarTextMuted}"
                                       FontSize="12"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom"
                            Style="{StaticResource SidebarCard}"
                            Margin="12,4,12,12"
                            TextElement.Foreground="{DynamicResource Nexus.SidebarText}">
                        <StackPanel>
                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="{DynamicResource Nexus.Success}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       MaxHeight="40"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding StatusMessage}" />
                            <TextBlock Text="{Binding WirelessLinkMessage}"
                                       Foreground="{DynamicResource Nexus.Warning}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       MaxHeight="36"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding WirelessLinkMessage}" />
                            <TextBlock Text="{Binding EndpointChangedBanner}"
                                       Foreground="{DynamicResource Nexus.Primary}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       MaxHeight="40"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding EndpointChangedBanner}"
                                       Visibility="{Binding ShowEndpointChangedBanner, Converter={StaticResource BoolToVis}}" />
                            <Button Margin="0,8,0,0"
                                    Content="Kablosuz ADB ayarı"
                                    ToolTip="Kablosuz hata ayıklama ayarını aç"
                                    Command="{Binding OpenWirelessDebugSettingsCommand}"
                                    Visibility="{Binding ShowOpenWirelessDebug, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource SidebarRefreshButton}"
                                    HorizontalAlignment="Stretch" />
                            <Button Margin="0,6,0,0"
                                    Content="USB ile kurtar"
                                    ToolTip="USB bağlıyken kablosuz hata ayıklamayı açmayı dene (root varsa otomatik)"
                                    Command="{Binding RecoverWirelessViaUsbCommand}"
                                    Visibility="{Binding ShowUsbRecoverWireless, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource SidebarRefreshButton}"
                                    HorizontalAlignment="Stretch" />
                            <TextBlock Text="{Binding WirelessPresenceHint}"
                                       Foreground="{DynamicResource Nexus.SidebarTextMuted}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding WirelessPresenceHint, Converter={StaticResource StringNotEmptyToVis}}" />
                            <Button Margin="0,6,0,0"
                                    Content="Yeniden bağlan"
                                    ToolTip="Wireless Guardian ile yeniden bağlan (mDNS / Companion / önbellek)"
                                    Command="{Binding ReconnectWirelessCommand}"
                                    Visibility="{Binding ShowReconnectWireless, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource SidebarRefreshButton}"
                                    HorizontalAlignment="Stretch" />
                            <Button Margin="0,6,0,0"
                                    Content="Wi‑Fi Bağlan"
                                    Command="{Binding ConnectWifiCommand}"
                                    Style="{StaticResource NexusPrimaryButton}"
                                    HorizontalAlignment="Stretch" />
                            <Button Margin="0,6,0,0"
                                    Content="Yenile"
                                    ToolTip="Cihazları yenile"
                                    Command="{Binding RefreshDevicesCommand}"
                                    Style="{StaticResource SidebarRefreshButton}"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="8,0,8,4"
                                  CanContentScroll="False">
                        <ListBox Style="{StaticResource NexusNavListBox}"
                                 ItemContainerStyle="{StaticResource NexusNavItem}"
                                 ItemsSource="{Binding NavItems}"
                                 SelectedIndex="{Binding SelectedNavIndex}"
                                 Foreground="{DynamicResource Nexus.SidebarText}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True" ToolTip="{Binding Label}">
                                        <materialDesign:PackIcon DockPanel.Dock="Left"
                                                                 Kind="{Binding IconKind}"
                                                                 Width="20" Height="20"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,10,0"
                                                                 Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IconKind}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Setter Property="Width" Value="0" />
                                                            <Setter Property="Margin" Value="0" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Setter Property="Width" Value="0" />
                                                            <Setter Property="Margin" Value="0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Background="{DynamicResource Nexus.Background}">
                <ContentControl prism:RegionManager.RegionName="ContentRegion" />
            </Grid>
        </Grid>
        </materialDesign:DialogHost>
    </Grid>
</Window>
