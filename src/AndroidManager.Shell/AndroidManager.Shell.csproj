<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AndroidManager.Shell</RootNamespace>
    <ApplicationTitle>SeND ANDROID MANAGER</ApplicationTitle>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="Prism.DryIoc" Version="9.0.537" />
    <PackageReference Include="Prism.Wpf" Version="9.0.537" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AndroidManager.Core\AndroidManager.Core.csproj" />
    <ProjectReference Include="..\AndroidManager.Device\AndroidManager.Device.csproj" />
    <ProjectReference Include="..\AndroidManager.Files\AndroidManager.Files.csproj" />
    <ProjectReference Include="..\AndroidManager.Apps\AndroidManager.Apps.csproj" />
    <ProjectReference Include="..\AndroidManager.Mirror\AndroidManager.Mirror.csproj" />
    <ProjectReference Include="..\AndroidManager.Gallery\AndroidManager.Gallery.csproj" />
    <ProjectReference Include="..\AndroidManager.Messages\AndroidManager.Messages.csproj" />
    <ProjectReference Include="..\AndroidManager.Backup\AndroidManager.Backup.csproj" />
    <ProjectReference Include="..\AndroidManager.Transfer\AndroidManager.Transfer.csproj" />
    <ProjectReference Include="..\AndroidManager.Security\AndroidManager.Security.csproj" />
    <ProjectReference Include="..\AndroidManager.Settings\AndroidManager.Settings.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\tools\adb\**\*" Link="adb\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\..\tools\adb')" />
    <Content Include="..\..\tools\ios\**\*" Link="ios\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\..\tools\ios')" />
    <Content Include="..\..\tools\whatsapp\**\*" Link="whatsapp\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\..\tools\whatsapp')" />
    <Content Include="..\..\tools\aapt\**\*" Link="tools\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\..\tools\aapt')" />
    <Content Include="..\..\tools\lpmake\**\*" Link="tools\lpmake\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\..\tools\lpmake\lpmake.exe')" />
    <Content Include="..\..\tools\erofs\**\*" Link="tools\erofs\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\..\tools\erofs\extract.erofs.exe')" />
    <Content Include="..\..\tools\scrcpy\**\*" Link="tools\scrcpy\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\..\tools\scrcpy')" />
    <Content Include="..\AndroidManager.Security\Scripts\**\*" Link="Scripts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
