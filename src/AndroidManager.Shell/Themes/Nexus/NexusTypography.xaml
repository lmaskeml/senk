<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Classic Segoe UI reads denser than Segoe UI Variable Display -->
    <FontFamily x:Key="Nexus.Font">Segoe UI, Inter, sans-serif</FontFamily>
    <FontFamily x:Key="Nexus.FontMono">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

    <Style x:Key="Nexus.Text.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Nexus.Font}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Nexus.TextPrimary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>
    <Style x:Key="Nexus.Text.H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Nexus.Font}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Nexus.TextPrimary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>
    <Style x:Key="Nexus.Text.H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Nexus.Font}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Nexus.TextPrimary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>
    <Style x:Key="Nexus.Text.H3" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Nexus.Font}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Nexus.TextPrimary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>
    <Style x:Key="Nexus.Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Nexus.Font}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Nexus.TextPrimary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>
    <Style x:Key="Nexus.Text.BodySmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Nexus.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Nexus.TextSecondary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>
    <Style x:Key="Nexus.Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Nexus.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Nexus.TextSecondary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>
    <Style x:Key="Nexus.Text.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Nexus.FontMono}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Nexus.TextPrimary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>
    <Style x:Key="Nexus.Text.MonoSmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Nexus.FontMono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Nexus.TextSecondary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>
    <Style x:Key="Nexus.Text.SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Nexus.Font}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Nexus.TextSecondary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- Default TextBlock: sharper, higher contrast when views omit explicit styles -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Nexus.Font}" />
        <Setter Property="FontSize" Value="{DynamicResource GlobalFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Nexus.TextPrimary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>
</ResourceDictionary>
