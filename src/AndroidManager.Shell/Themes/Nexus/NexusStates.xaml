<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="NexusStatusBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Nexus.SuccessSubtle}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Nexus.RadiusBadge}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="NexusStatusBadgeText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Nexus.Font}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Nexus.Success}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="NexusEmptyState" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="32" />
    </Style>

    <Style x:Key="NexusErrorPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Nexus.DangerSubtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nexus.Danger}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Nexus.RadiusCard}" />
        <Setter Property="Padding" Value="{DynamicResource Nexus.CardPadding}" />
    </Style>

    <Style x:Key="NexusSkeletonBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Nexus.SurfaceHover}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Opacity" Value="0.7" />
    </Style>
</ResourceDictionary>
