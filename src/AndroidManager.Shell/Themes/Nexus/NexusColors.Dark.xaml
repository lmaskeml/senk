<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Nexus.Background.Color">#0B0F14</Color>
    <Color x:Key="Nexus.Sidebar.Color">#080C11</Color>
    <Color x:Key="Nexus.Surface.Color">#121820</Color>
    <Color x:Key="Nexus.SurfaceElevated.Color">#171F29</Color>
    <Color x:Key="Nexus.SurfaceHover.Color">#1B2530</Color>
    <Color x:Key="Nexus.Border.Color">#26313D</Color>
    <Color x:Key="Nexus.Primary.Color">#22D3EE</Color>
    <Color x:Key="Nexus.PrimaryHover.Color">#38BDF8</Color>
    <Color x:Key="Nexus.Success.Color">#22C55E</Color>
    <Color x:Key="Nexus.Warning.Color">#F59E0B</Color>
    <Color x:Key="Nexus.Danger.Color">#EF4444</Color>
    <Color x:Key="Nexus.TextPrimary.Color">#F8FAFC</Color>
    <Color x:Key="Nexus.TextSecondary.Color">#CBD5E1</Color>
    <Color x:Key="Nexus.TextMuted.Color">#94A3B8</Color>
    <SolidColorBrush x:Key="Nexus.Background" Color="{StaticResource Nexus.Background.Color}" />
    <SolidColorBrush x:Key="Nexus.Sidebar" Color="{StaticResource Nexus.Sidebar.Color}" />
    <SolidColorBrush x:Key="Nexus.Surface" Color="{StaticResource Nexus.Surface.Color}" />
    <SolidColorBrush x:Key="Nexus.SurfaceElevated" Color="{StaticResource Nexus.SurfaceElevated.Color}" />
    <SolidColorBrush x:Key="Nexus.SurfaceHover" Color="{StaticResource Nexus.SurfaceHover.Color}" />
    <SolidColorBrush x:Key="Nexus.Border" Color="{StaticResource Nexus.Border.Color}" />
    <SolidColorBrush x:Key="Nexus.Primary" Color="{StaticResource Nexus.Primary.Color}" />
    <SolidColorBrush x:Key="Nexus.PrimaryHover" Color="{StaticResource Nexus.PrimaryHover.Color}" />
    <SolidColorBrush x:Key="Nexus.Success" Color="{StaticResource Nexus.Success.Color}" />
    <SolidColorBrush x:Key="Nexus.Warning" Color="{StaticResource Nexus.Warning.Color}" />
    <SolidColorBrush x:Key="Nexus.Danger" Color="{StaticResource Nexus.Danger.Color}" />
    <SolidColorBrush x:Key="Nexus.TextPrimary" Color="{StaticResource Nexus.TextPrimary.Color}" />
    <SolidColorBrush x:Key="Nexus.TextSecondary" Color="{StaticResource Nexus.TextSecondary.Color}" />
    <SolidColorBrush x:Key="Nexus.TextMuted" Color="{StaticResource Nexus.TextMuted.Color}" />
    <SolidColorBrush x:Key="Nexus.PrimarySubtle" Color="#2222D3EE" />
    <SolidColorBrush x:Key="Nexus.SuccessSubtle" Color="#2222C55E" />
    <SolidColorBrush x:Key="Nexus.WarningSubtle" Color="#22F59E0B" />
    <SolidColorBrush x:Key="Nexus.DangerSubtle" Color="#22EF4444" />
    <SolidColorBrush x:Key="Nexus.Overlay" Color="#990B0F14" />
    <!-- Sidebar chrome: always light ink on dark rail (theme-independent) -->
    <SolidColorBrush x:Key="Nexus.SidebarText" Color="#F8FAFC" />
    <SolidColorBrush x:Key="Nexus.SidebarTextMuted" Color="#A8B4C4" />
    <SolidColorBrush x:Key="Nexus.SidebarCard" Color="#171F29" />
    <SolidColorBrush x:Key="Nexus.SidebarCardBorder" Color="#334155" />

    <!-- MaterialDesign 5: input / combo / checkbox mürekkebi Nexus metnine bağlı -->
    <SolidColorBrush x:Key="MaterialDesignBody" Color="{StaticResource Nexus.TextPrimary.Color}" />
    <SolidColorBrush x:Key="MaterialDesignBodyLight" Color="{StaticResource Nexus.TextSecondary.Color}" />
    <SolidColorBrush x:Key="MaterialDesignColumnHeader" Color="{StaticResource Nexus.TextSecondary.Color}" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Foreground" Color="{StaticResource Nexus.TextPrimary.Color}" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Foreground.Light" Color="{StaticResource Nexus.TextSecondary.Color}" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Foreground.Hint" Color="{StaticResource Nexus.TextMuted.Color}" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Foreground.Disabled" Color="{StaticResource Nexus.TextMuted.Color}" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Foreground.TextBox" Color="{StaticResource Nexus.TextPrimary.Color}" />
</ResourceDictionary>
