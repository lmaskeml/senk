<UserControl x:Class="AndroidManager.Security.Views.RescueCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource Nexus.Background}"
             d:DesignHeight="720" d:DesignWidth="960">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Style="{StaticResource NexusPageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="24,20,24,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Rescue Center" Style="{StaticResource Nexus.Text.H1}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Nexus.Text.Caption}"
                           Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}"
                    Style="{StaticResource NexusPrimaryButton}"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0"
                                 VerticalAlignment="Center"
                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <TextBlock Text="Yenile" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>
        <ProgressBar Grid.Row="1" Height="3" IsIndeterminate="True" Margin="24,12,24,0"
                     Foreground="{DynamicResource Nexus.Primary}"
                     Background="Transparent" BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        <Grid Grid.Row="2" Margin="24,16,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Connection + critical actions -->
            <Border Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource NexusCardElevated}">
                <StackPanel>
                    <TextBlock Text="BAĞLANTI DURUMU"
                               Style="{StaticResource NexusSectionHeader}" />

                    <WrapPanel Margin="0,0,0,12">
                        <Border Style="{StaticResource NexusStatusBadge}" Margin="0,0,8,8"
                                Background="{DynamicResource Nexus.PrimarySubtle}">
                            <TextBlock Style="{StaticResource Nexus.Text.Caption}"
                                       Foreground="{DynamicResource Nexus.TextPrimary}">
                                <Run Text="ADB: " FontWeight="SemiBold" />
                                <Run Text="{Binding Snapshot.Adb}" />
                            </TextBlock>
                        </Border>
                        <Border Style="{StaticResource NexusStatusBadge}" Margin="0,0,8,8"
                                Background="{DynamicResource Nexus.WarningSubtle}">
                            <TextBlock Style="{StaticResource Nexus.Text.Caption}"
                                       Foreground="{DynamicResource Nexus.TextPrimary}">
                                <Run Text="Fastboot: " FontWeight="SemiBold" />
                                <Run Text="{Binding Snapshot.Fastboot}" />
                                <Run Text="{Binding FastbootHint, StringFormat= ({0})}"
                                     Foreground="{DynamicResource Nexus.TextMuted}" />
                            </TextBlock>
                        </Border>
                        <Border Style="{StaticResource NexusStatusBadge}" Margin="0,0,8,8"
                                Background="{DynamicResource Nexus.SurfaceElevated}">
                            <TextBlock Style="{StaticResource Nexus.Text.Caption}"
                                       Foreground="{DynamicResource Nexus.TextPrimary}">
                                <Run Text="Recovery: " FontWeight="SemiBold" />
                                <Run Text="{Binding Snapshot.Recovery}" />
                            </TextBlock>
                        </Border>
                    </WrapPanel>

                    <TextBlock Text="{Binding Snapshot.Summary}" TextWrapping="Wrap"
                               Style="{StaticResource Nexus.Text.Body}"
                               Margin="0,0,0,12" />

                    <ItemsControl ItemsSource="{Binding Snapshot.SafeActions}" Margin="0,0,0,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,2"
                                           Style="{StaticResource Nexus.Text.Caption}"
                                           Text="{Binding StringFormat=• {0}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="YENİDEN BAŞLATMA"
                               Style="{StaticResource NexusSectionHeader}" />

                    <Button Content="Sisteme Yeniden Başlat" Command="{Binding RebootSystemCommand}"
                            Style="{StaticResource NexusPrimaryButton}"
                            HorizontalAlignment="Stretch" Margin="0,0,0,10" />

                    <!-- Critical: Fastboot / Recovery with Warning accent -->
                    <Border BorderBrush="{DynamicResource Nexus.Warning}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Nexus.RadiusCard}"
                            Background="{DynamicResource Nexus.WarningSubtle}"
                            Padding="12" Margin="0,0,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <md:PackIcon DockPanel.Dock="Left" Kind="Alert"
                                             Width="16" Height="16" Margin="0,0,8,0"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource Nexus.Warning}" />
                                <TextBlock Text="Kritik boot modları — cihaz geçici olarak erişilemez olabilir"
                                           Style="{StaticResource Nexus.Text.Caption}"
                                           Foreground="{DynamicResource Nexus.Warning}"
                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                            <WrapPanel>
                                <Button Command="{Binding RebootFastbootCommand}"
                                        Style="{StaticResource NexusDangerButton}"
                                        Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="Flash" Width="14" Height="14" Margin="0,0,6,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="Fastboot" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RebootRecoveryCommand}"
                                        Style="{StaticResource NexusDangerButton}"
                                        Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="BackupRestore" Width="14" Height="14" Margin="0,0,6,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="Recovery" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Backups -->
            <Border Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource NexusCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="MEVCUT PARTITION YEDEKLERİ"
                               Style="{StaticResource NexusSectionHeader}" />
                    <ListView ItemsSource="{Binding Snapshot.AvailableBackups}"
                              SelectedItem="{Binding SelectedBackup}"
                              Foreground="{DynamicResource Nexus.TextPrimary}"
                              Background="Transparent"
                              BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Partition" Width="120" DisplayMemberBinding="{Binding PartitionName}" />
                                <GridViewColumn Header="Boyut" Width="90" DisplayMemberBinding="{Binding SizeBytes}" />
                                <GridViewColumn Header="Dosya" Width="220" DisplayMemberBinding="{Binding FilePath}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
