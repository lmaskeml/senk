<UserControl x:Class="AndroidManager.Security.Views.RecoveryManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource Nexus.Background}"
             d:DesignHeight="720" d:DesignWidth="960">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Style="{StaticResource NexusPageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="24,20,24,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Recovery Manager" Style="{StaticResource Nexus.Text.H1}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Nexus.Text.Caption}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}"
                    Style="{StaticResource NexusPrimaryButton}"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0"
                                 VerticalAlignment="Center"
                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <TextBlock Text="Yenile" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>
        <ProgressBar Grid.Row="1" Height="3" IsIndeterminate="True" Margin="24,12,24,0"
                     Foreground="{DynamicResource Nexus.Primary}"
                     Background="Transparent" BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        <ScrollViewer Grid.Row="2" Style="{StaticResource NexusPageScroll}">
            <StackPanel MaxWidth="640">
                <Border Style="{StaticResource NexusCardElevated}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding Profile.DisplayName, FallbackValue=Cihaz yok}"
                                   Style="{StaticResource Nexus.Text.H2}" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding Status.Detail}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource Nexus.Text.Body}" />

                        <WrapPanel Margin="0,16,0,0">
                            <Border Style="{StaticResource NexusStatusBadge}" Margin="0,0,8,8"
                                    Background="{DynamicResource Nexus.PrimarySubtle}">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="BackupRestore" Width="14" Height="14" Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource Nexus.Primary}" />
                                    <TextBlock Style="{StaticResource Nexus.Text.Caption}"
                                               Foreground="{DynamicResource Nexus.TextPrimary}">
                                        <Run Text="Recovery: " />
                                        <Run Text="{Binding Status.Label, FallbackValue=—}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource NexusStatusBadge}" Margin="0,0,8,8"
                                    Background="{DynamicResource Nexus.WarningSubtle}">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="LockOpenVariant" Width="14" Height="14" Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource Nexus.Warning}" />
                                    <TextBlock Style="{StaticResource Nexus.Text.Caption}"
                                               Foreground="{DynamicResource Nexus.TextPrimary}">
                                        <Run Text="Bootloader: " />
                                        <Run Text="{Binding Status.BootloaderUnlocked, TargetNullValue=—}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource NexusStatusBadge}" Margin="0,0,8,8"
                                    Background="{DynamicResource Nexus.SuccessSubtle}">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="ShieldAccount" Width="14" Height="14" Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource Nexus.Success}" />
                                    <TextBlock Style="{StaticResource Nexus.Text.Caption}"
                                               Foreground="{DynamicResource Nexus.TextPrimary}">
                                        <Run Text="Root: " />
                                        <Run Text="{Binding Status.IsRooted}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Recovery İmajı Yükle -->
                <Border Style="{StaticResource NexusCardElevated}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="RECOVERY İMAJI YÜKLE"
                                   Style="{StaticResource NexusSectionHeader}" />
                        <TextBlock Text="Özel recovery (TWRP, OrangeFox vb.) imajını cihaza yazın."
                                   Style="{StaticResource Nexus.Text.Caption}" Margin="0,0,0,12"
                                   TextWrapping="Wrap" />

                        <!-- Dosya Seçimi -->
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Command="{Binding BrowseRecoveryImageCommand}"
                                    Style="{StaticResource NexusSecondaryButton}"
                                    Margin="8,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="FolderOpen" Width="14" Height="14" Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Gözat" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border Background="{DynamicResource Nexus.Surface}" CornerRadius="6"
                                    Padding="10,8" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RecoveryImageName}"
                                           Style="{StaticResource Nexus.Text.Body}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding RecoveryImagePath}" />
                            </Border>
                        </DockPanel>

                        <!-- Yöntem Seçimi -->
                        <TextBlock Text="Yükleme Yöntemi" Style="{StaticResource Nexus.Text.Body}"
                                   FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel Margin="0,0,0,4">
                            <RadioButton Content="Fastboot Flash Boot (Önerilen — Xiaomi / özel ROM, boot_b'ye yazar)"
                                         GroupName="FlashMethod"
                                         IsChecked="{Binding IsFastbootFlashBootSelected}"
                                         Margin="0,0,0,6"
                                         Style="{StaticResource MaterialDesignRadioButton}" />
                            <RadioButton Content="Fastboot Flash Recovery (Kalıcı — recovery bölümüne yazar)"
                                         GroupName="FlashMethod"
                                         IsChecked="{Binding IsFastbootFlashRecoverySelected}"
                                         Margin="0,0,0,6"
                                         Style="{StaticResource MaterialDesignRadioButton}" />
                            <RadioButton Content="Fastboot Boot (Geçici — RAM'den bir kez açar)"
                                         GroupName="FlashMethod"
                                         IsChecked="{Binding IsFastbootBootSelected}"
                                         Margin="0,0,0,6"
                                         Style="{StaticResource MaterialDesignRadioButton}" />
                            <RadioButton Content="Root DD (Canlı sistem — root gerekir)"
                                         GroupName="FlashMethod"
                                         IsChecked="{Binding IsRootDdSelected}"
                                         Style="{StaticResource MaterialDesignRadioButton}" />
                        </StackPanel>
                        <TextBlock Text="{Binding FlashMethodHint}"
                                   Style="{StaticResource Nexus.Text.Caption}"
                                   TextWrapping="Wrap" Margin="0,4,0,12"
                                   Foreground="{DynamicResource Nexus.TextSecondary}" />

                        <!-- Durum -->
                        <TextBlock Text="{Binding FlashStatusMessage}"
                                   Foreground="{DynamicResource Nexus.Warning}"
                                   TextWrapping="Wrap" Margin="0,0,0,8">
                            <TextBlock.Visibility>
                                <Binding Path="HasFlashStatusMessage"
                                         Converter="{StaticResource BoolToVis}" />
                            </TextBlock.Visibility>
                        </TextBlock>

                        <Button Command="{Binding FlashRecoveryCommand}"
                                Style="{StaticResource NexusPrimaryButton}"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="CellphoneArrowDown" Width="16" Height="16" Margin="0,0,8,0"
                                             VerticalAlignment="Center"
                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Recovery Yükle" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Kritik İşlem -->
                <Border Style="{StaticResource NexusCardElevated}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="RECOVERY ZIP / DOSYA KUR" Style="{StaticResource NexusSectionHeader}" />
                        <TextBlock Text="TWRP/OrangeFox ADB ile zip kurabilir; cihaz rootluysa Magisk/OTA ziplere özel canlı (recovery command) kurulum seçeneği kullanılabilir."
                                   Style="{StaticResource Nexus.Text.Caption}" Margin="0,0,0,12"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="Yükleme Yöntemi" Style="{StaticResource Nexus.Text.Body}"
                                   FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel Margin="0,0,0,4">
                            <RadioButton Content="Recovery ADB ile (TWRP/OrangeFox) — twrp install / fox install"
                                         GroupName="ZipInstallMethod"
                                         IsChecked="{Binding IsTwrpAdbInstallSelected}"
                                         Margin="0,0,0,6"
                                         Style="{StaticResource MaterialDesignRadioButton}" />
                            <RadioButton Content="Root ile Canlı (OTA-command) — Magisk/OTA"
                                         GroupName="ZipInstallMethod"
                                         IsChecked="{Binding IsRootOtaInstallSelected}"
                                         Margin="0,0,0,6"
                                         Style="{StaticResource MaterialDesignRadioButton}" />
                        </StackPanel>

                        <TextBlock Text="{Binding ZipInstallHint}"
                                   Style="{StaticResource Nexus.Text.Caption}"
                                   TextWrapping="Wrap" Margin="0,4,0,12"
                                   Foreground="{DynamicResource Nexus.TextSecondary}" />

                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding PickZipFilesCommand}"
                                    Style="{StaticResource NexusSecondaryButton}"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="FolderOpen" Width="14" Height="14" Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="ZIP seç" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <ListBox ItemsSource="{Binding SelectedZipPaths}"
                                 Height="90"
                                 Margin="0,0,0,12"
                                 Background="{DynamicResource Nexus.Surface}"
                                 BorderBrush="{DynamicResource Nexus.Border}"
                                 BorderThickness="1"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />

                        <TextBlock Text="{Binding ZipInstallStatusMessage}"
                                   Foreground="{DynamicResource Nexus.Warning}"
                                   TextWrapping="Wrap" Margin="0,0,0,8">
                            <TextBlock.Visibility>
                                <Binding Path="HasZipInstallStatusMessage"
                                         Converter="{StaticResource BoolToVis}" />
                            </TextBlock.Visibility>
                        </TextBlock>

                        <Button Command="{Binding InstallZipsCommand}"
                                Style="{StaticResource NexusPrimaryButton}"
                                HorizontalAlignment="Left"
                                Content="ZIP(ler)i Kur" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource NexusCard}"
                        BorderBrush="{DynamicResource Nexus.Warning}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="KRİTİK İŞLEM"
                                   Style="{StaticResource NexusSectionHeader}" />
                        <Button Command="{Binding RebootRecoveryCommand}"
                                Style="{StaticResource NexusDangerButton}"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Restart" Width="16" Height="16" Margin="0,0,8,0"
                                             VerticalAlignment="Center"
                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Recovery'ye Yeniden Başlat" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
