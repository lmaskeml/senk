<UserControl x:Class="AndroidManager.Security.Views.RootSecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:c="clr-namespace:AndroidManager.Security.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="960"
             Background="{DynamicResource Nexus.Background}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <c:InverseBooleanConverter x:Key="InvertBool" />
        <c:NonZeroToVisibilityConverter x:Key="NonZeroToVis" />
        <c:BankHideStatusBrushConverter x:Key="BankHideBrush" />
    </UserControl.Resources>

    <Grid Style="{StaticResource NexusPageRoot}" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Root Modu" Style="{StaticResource Nexus.Text.H1}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Nexus.Text.Caption}"
                           Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding AnalyzeRootWizardCommand}"
                        Style="{StaticResource NexusSecondaryButton}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="ShieldSearch" Width="16" Height="16" Margin="0,0,6,0"
                                     VerticalAlignment="Center"
                                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="Root Analizi" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding CheckRootCommand}"
                        Style="{StaticResource NexusSecondaryButton}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0"
                                     VerticalAlignment="Center"
                                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="Kontrol" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding EnableRootCommand}"
                        Style="{StaticResource NexusPrimaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="ShieldCheck" Width="16" Height="16" Margin="0,0,6,0"
                                     VerticalAlignment="Center"
                                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="Root'u Etkinleştir" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <ProgressBar Grid.Row="1" Height="3" IsIndeterminate="True" Margin="0,0,0,10"
                     Foreground="{DynamicResource Nexus.Primary}"
                     Background="Transparent" BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTab}"
                    Background="{DynamicResource Nexus.Background}"
                    BorderThickness="0">
            <TabItem Header="Root durumu">
                <ScrollViewer Style="{StaticResource NexusPageScroll}">
                    <StackPanel MaxWidth="820">
                        <!-- Premium root status hero -->
                        <Border x:Name="RootStatusHero" Margin="0,0,0,16" Padding="24,22">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource NexusCardElevated}">
                                    <Setter Property="Background" Value="{DynamicResource Nexus.DangerSubtle}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Nexus.Danger}" />
                                    <Setter Property="BorderThickness" Value="2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RootStatus.IsRooted}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Nexus.SuccessSubtle}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Nexus.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="56" Height="56" CornerRadius="28" Margin="0,0,20,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Nexus.Surface}">
                                    <md:PackIcon Width="28" Height="28"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <md:PackIcon.Style>
                                            <Style TargetType="md:PackIcon">
                                                <Setter Property="Kind" Value="ShieldOff" />
                                                <Setter Property="Foreground" Value="{DynamicResource Nexus.Danger}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RootStatus.IsRooted}" Value="True">
                                                        <Setter Property="Kind" Value="ShieldCheck" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Nexus.Success}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </md:PackIcon.Style>
                                    </md:PackIcon>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontSize="28">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Nexus.Text.H1}">
                                                <Setter Property="Text" Value="ROOT YOK" />
                                                <Setter Property="Foreground" Value="{DynamicResource Nexus.Danger}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RootStatus.IsRooted}" Value="True">
                                                        <Setter Property="Text" Value="ROOT AKTİF" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Nexus.Success}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding RootStatus.StatusText, FallbackValue=Kontrol edilmedi}"
                                               Style="{StaticResource Nexus.Text.H3}"
                                               Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding RootStatus.Detail, FallbackValue=—}"
                                               Style="{StaticResource Nexus.Text.Body}"
                                               Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <Border Style="{StaticResource NexusStatusBadge}" Margin="0,12,0,0"
                                            Background="{DynamicResource Nexus.Surface}">
                                        <TextBlock Style="{StaticResource Nexus.Text.Mono}">
                                            <Run Text="su: " />
                                            <Run Text="{Binding RootStatus.SuPath, FallbackValue=—}" />
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <Border Style="{StaticResource NexusCard}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="BOOT / SELINUX"
                                               Style="{StaticResource NexusSectionHeader}" />
                                    <TextBlock Text="{Binding BootInfo.StatusText, FallbackValue=—}"
                                               Style="{StaticResource Nexus.Text.Body}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Nexus.Text.Caption}">
                                        <Run Text="Bootloader: " />
                                        <Run Text="{Binding BootInfo.BootloaderLockedText, FallbackValue=—}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Nexus.Text.Caption}">
                                        <Run Text="Debug: " />
                                        <Run Text="{Binding BootInfo.DebuggableText, FallbackValue=—}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Nexus.Text.Caption}">
                                        <Run Text="SELinux: " />
                                        <Run Text="{Binding BootInfo.SelinuxMode, FallbackValue=—}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource NexusCard}" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="MOUNT"
                                               Style="{StaticResource NexusSectionHeader}" />
                                    <TextBlock Text="{Binding MountStatus.Summary, FallbackValue=—}"
                                               Style="{StaticResource Nexus.Text.Body}"
                                               TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="rw mount" Command="{Binding MountRwCommand}"
                                                Style="{StaticResource NexusSecondaryButton}"
                                                Margin="0,0,8,0" />
                                        <Button Content="ro mount" Command="{Binding MountRoCommand}"
                                                Style="{StaticResource NexusSecondaryButton}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Derin tarama">
                <Grid Margin="8" Background="{DynamicResource Nexus.Background}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource NexusCard}" Margin="0,0,0,8" Padding="12">
                        <WrapPanel>
                            <CheckBox Content="Değişen dosyalar" IsChecked="{Binding ScanRecentFiles}"
                                      Margin="0,0,12,6" Foreground="{DynamicResource Nexus.TextPrimary}" />
                            <CheckBox Content="Init scriptleri" IsChecked="{Binding ScanInitScripts}"
                                      Margin="0,0,12,6" Foreground="{DynamicResource Nexus.TextPrimary}" />
                            <CheckBox Content="Magisk modülleri" IsChecked="{Binding ScanMagiskModules}"
                                      Margin="0,0,12,6" Foreground="{DynamicResource Nexus.TextPrimary}" />
                            <CheckBox Content="hosts" IsChecked="{Binding ScanHosts}"
                                      Margin="0,0,12,6" Foreground="{DynamicResource Nexus.TextPrimary}" />
                            <CheckBox Content="Erişilebilirlik" IsChecked="{Binding ScanAccessibility}"
                                      Margin="0,0,12,6" Foreground="{DynamicResource Nexus.TextPrimary}" />
                        </WrapPanel>
                    </Border>

                    <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Content="Taramayı başlat" Command="{Binding ScanSystemCommand}"
                                    Style="{StaticResource NexusPrimaryButton}" Margin="0,0,8,0" />
                            <Button Content="İptal" Command="{Binding CancelScanCommand}"
                                    Style="{StaticResource NexusTertiaryButton}" Margin="0,0,8,0" />
                            <Button Content="Tümünü seç" Command="{Binding SelectAllCommand}"
                                    Style="{StaticResource NexusSecondaryButton}" Margin="0,0,8,0" />
                            <Button Content="Seçilenleri temizle" Command="{Binding CleanSelectedCommand}"
                                    Style="{StaticResource NexusDangerButton}" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Text="{Binding ScanProgress.Phase}"
                                       Style="{StaticResource Nexus.Text.Caption}"
                                       Margin="0,0,12,0" />
                            <ProgressBar Width="160" Height="6" Maximum="100"
                                         Value="{Binding ScanProgress.Percentage}"
                                         Foreground="{DynamicResource Nexus.Primary}"
                                         Background="{DynamicResource Nexus.SurfaceHover}"
                                         BorderThickness="0"
                                         Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="2" Style="{StaticResource NexusCard}" Padding="0">
                        <ListView ItemsSource="{Binding SystemThreats}"
                                  BorderThickness="0"
                                  Background="Transparent">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="36">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Seviye" Width="80" DisplayMemberBinding="{Binding SeverityLabel}" />
                                    <GridViewColumn Header="Tür" Width="100" DisplayMemberBinding="{Binding TypeLabel}" />
                                    <GridViewColumn Header="Ad" Width="220" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="Açıklama" Width="280" DisplayMemberBinding="{Binding Description}" />
                                    <GridViewColumn Header="" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Temizle"
                                                        Style="{StaticResource NexusDangerButton}"
                                                        Padding="8,4"
                                                        Command="{Binding DataContext.CleanSingleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Root işlemleri">
                <ScrollViewer Style="{StaticResource NexusPageScroll}">
                    <StackPanel MaxWidth="640">
                        <Border Style="{StaticResource NexusCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="HEDEF PAKET"
                                           Style="{StaticResource NexusSectionHeader}" />
                                <TextBox Text="{Binding TargetPackage, UpdateSourceTrigger=PropertyChanged}"
                                         md:HintAssist.Hint="örn. com.suspicious.app"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="İşlemi öldür" Command="{Binding KillTargetCommand}"
                                            Style="{StaticResource NexusDangerButton}"
                                            Margin="0,0,8,0" />
                                    <Button Content="Veriyi temizle" Command="{Binding ClearTargetDataCommand}"
                                            Style="{StaticResource NexusDangerButton}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NexusCard}" Margin="0,0,0,12"
                                BorderBrush="{DynamicResource Nexus.Warning}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="SİSTEM ONARIMI"
                                           Style="{StaticResource NexusSectionHeader}" />
                                <Button Content="hosts dosyasını onar" Command="{Binding RestoreHostsCommand}"
                                        Style="{StaticResource NexusSecondaryButton}"
                                        HorizontalAlignment="Left" Margin="0,0,0,8" />
                                <Button Content="Cihazı yeniden başlat" Command="{Binding RebootCommand}"
                                        Style="{StaticResource NexusDangerButton}"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Nexus.Text.Caption}" TextWrapping="Wrap"
                                   Text="Karantina dizini: /data/local/tmp/androidmanager_quarantine — dosyalar silinmez, taşınır. Dynamic partition cihazlarda /system remount başarısız olabilir; Magisk gerekebilir." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Magisk modulleri">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="180" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource NexusCard}" Margin="0,0,0,8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Magisk / KernelSU / APatch modul kurulumu"
                                       Style="{StaticResource Nexus.Text.H3}" />
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                       Style="{StaticResource Nexus.Text.Caption}"
                                       Text="Zip secin; program magisk --install-module ile kurar. Magisk uygulamasinin adini bankalar icin gizlemeniz/degistirmeniz modul listesini ETKILEMEZ — liste /data/adb/modules klasorunden okunur." />
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="{Binding MagiskEnvironmentNote}"
                                       Style="{StaticResource Nexus.Text.Caption}"
                                       Foreground="{DynamicResource Nexus.Warning}"
                                       Visibility="{Binding MagiskManagerHidden, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>
                    <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Content="Modul zip kur" Command="{Binding InstallMagiskModulesCommand}"
                                    Style="{StaticResource NexusPrimaryButton}" Margin="0,0,8,0" />
                            <Button Content="Listeyi yenile" Command="{Binding RefreshMagiskModulesCommand}"
                                    Style="{StaticResource NexusSecondaryButton}" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                   Text="{Binding MagiskStatus}"
                                   Style="{StaticResource Nexus.Text.Caption}" />
                    </DockPanel>
                    <Border Grid.Row="2" Style="{StaticResource NexusCard}" Padding="0" Margin="0,0,0,8">
                        <Grid>
                            <ListView ItemsSource="{Binding MagiskModules}"
                                      BorderThickness="0"
                                      Background="Transparent">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Durum" Width="140" DisplayMemberBinding="{Binding StatusLabel}" />
                                        <GridViewColumn Header="Ad" Width="180" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="Surum" Width="90" DisplayMemberBinding="{Binding Version}" />
                                        <GridViewColumn Header="Yazar" Width="120" DisplayMemberBinding="{Binding Author}" />
                                        <GridViewColumn Header="Aciklama" Width="220" DisplayMemberBinding="{Binding Description}" />
                                        <GridViewColumn Header="" Width="90">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding ToggleLabel}" Padding="8,4"
                                                            Command="{Binding DataContext.ToggleMagiskModuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource NexusSecondaryButton}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="" Width="90">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Kaldir" Padding="8,4"
                                                            Command="{Binding DataContext.RemoveMagiskModuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource NexusDangerButton}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <ProgressBar Height="3" VerticalAlignment="Top" IsIndeterminate="True" BorderThickness="0"
                                         Visibility="{Binding MagiskBusy, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>
                    <DockPanel Grid.Row="3" Margin="0,0,0,8" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Content="YKB kalici pin (boot+CLI)" Command="{Binding PinBankDenyListCommand}"
                                    Style="{StaticResource NexusPrimaryButton}" Margin="0,0,8,0" />
                            <Button Content="Enforce kapat (Shamiko)" Command="{Binding DisableDenyListEnforceCommand}"
                                    Style="{StaticResource NexusSecondaryButton}" Margin="0,0,8,0" />
                            <Button Content="DenyList yenile" Command="{Binding RefreshDenyListCommand}"
                                    Style="{StaticResource NexusSecondaryButton}" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                                   Text="{Binding DenyListStatus}"
                                   Style="{StaticResource Nexus.Text.Caption}" />
                    </DockPanel>
                    <Border Grid.Row="4" Style="{StaticResource NexusCard}" Padding="8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" TextWrapping="Wrap"
                                       Style="{StaticResource Nexus.Text.Caption}"
                                       Text="YKB icin Magisk Red Listesi tik'ine BAKMA — dinamik surec + Magisk UI bilinen bug. senk DenyList listesi / CLI gercektir. Pin = watchdog (20sn) + boot yeniden yazim." />
                            <ListBox ItemsSource="{Binding DenyListEntries}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontFamily="Consolas"
                                     FontSize="12" />
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Banka gizleme (YKB)">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource NexusCard}" Margin="0,0,0,8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="3 katman: Shamiko + PIF + HMA (paket taramasi)"
                                       Style="{StaticResource Nexus.Text.H3}" />
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                       Style="{StaticResource Nexus.Text.Caption}"
                                       Text="{Binding BankHideSummary}" />
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Nexus.Warning}"
                                       Style="{StaticResource Nexus.Text.Caption}"
                                       Text="Magisk Red Listesi tik'i YKB'de kalici olmayabilir. DenyList CLI + Shamiko + HMA birlikte sart." />
                        </StackPanel>
                    </Border>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                        <Button Content="Denetimi calistir" Command="{Binding RunBankHideAuditCommand}"
                                Style="{StaticResource NexusSecondaryButton}" Margin="0,0,8,8" />
                        <Button Content="DenyList pin (Katman 1)" Command="{Binding ApplyBankHideDenyListCommand}"
                                Style="{StaticResource NexusPrimaryButton}" Margin="0,0,8,8" />
                        <Button Content="Stack modul kur" Command="{Binding InstallBankStackModulesCommand}"
                                Style="{StaticResource NexusPrimaryButton}" Margin="0,0,8,8" />
                        <Button Content="YKB veri temizle" Command="{Binding ClearYkbBankHideCommand}"
                                Style="{StaticResource NexusSecondaryButton}" Margin="0,0,8,8" />
                        <Button Content="GMS onbellek" Command="{Binding ClearGmsBankHideCommand}"
                                Style="{StaticResource NexusSecondaryButton}" Margin="0,0,8,8" />
                        <Button Content="LSPosed Manager kur" Command="{Binding InstallLsposedManagerCommand}"
                                Style="{StaticResource NexusPrimaryButton}" Margin="0,0,8,8" />
                        <Button Content="HMA rehberi" Command="{Binding ShowBankHideHmaGuideCommand}"
                                Style="{StaticResource NexusSecondaryButton}" Margin="0,0,8,8" />
                    </WrapPanel>
                    <Border Grid.Row="2" Style="{StaticResource NexusCard}" Padding="0">
                        <ListView ItemsSource="{Binding BankHideChecks}" BorderThickness="0" Background="Transparent">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="" Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold"
                                                           Foreground="{Binding Status, Converter={StaticResource BankHideBrush}}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Kontrol" Width="160" DisplayMemberBinding="{Binding Title}" />
                                    <GridViewColumn Header="Durum" Width="220" DisplayMemberBinding="{Binding Detail}" />
                                    <GridViewColumn Header="Cozum" Width="280" DisplayMemberBinding="{Binding FixHint}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                    <TextBlock Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap"
                               Style="{StaticResource Nexus.Text.Caption}"
                               Text="{Binding BankHideGuide}" />
                </Grid>
            </TabItem>
            <TabItem Header="Root Sihirbazı">
                <ScrollViewer Style="{StaticResource NexusPageScroll}">
                    <StackPanel MaxWidth="820">
                        <Border Style="{StaticResource NexusCardElevated}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding RootRecommendation.DisplayName, FallbackValue=Root analizi yapılmadı}"
                                           Style="{StaticResource Nexus.Text.H2}" />
                                <TextBlock Text="{Binding RootRecommendation.Summary, FallbackValue=Root Analizi butonuna tıklayın.}"
                                           Margin="0,8,0,0" TextWrapping="Wrap"
                                           Style="{StaticResource Nexus.Text.Body}" />
                            </StackPanel>
                        </Border>
                        <WrapPanel Margin="0,0,0,12">
                            <Border Style="{StaticResource NexusStatusBadge}" Margin="0,0,8,8"
                                    Background="{DynamicResource Nexus.PrimarySubtle}">
                                <TextBlock Style="{StaticResource Nexus.Text.Caption}"
                                           Foreground="{DynamicResource Nexus.TextPrimary}">
                                    <Run Text="Cihaz: " />
                                    <Run Text="{Binding DeviceProfile.DisplayName, FallbackValue=—}" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource NexusStatusBadge}" Margin="0,0,8,8"
                                    Background="{DynamicResource Nexus.SurfaceElevated}">
                                <TextBlock Style="{StaticResource Nexus.Text.Caption}">
                                    <Run Text="Uyumluluk: " />
                                    <Run Text="{Binding DeviceProfile.Compatibility, FallbackValue=—}" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource NexusStatusBadge}" Margin="0,0,8,8"
                                    Background="{DynamicResource Nexus.WarningSubtle}">
                                <TextBlock Style="{StaticResource Nexus.Text.Caption}"
                                           Foreground="{DynamicResource Nexus.Warning}">
                                    <Run Text="Patch: " />
                                    <Run Text="{Binding RootRecommendation.PatchTarget, FallbackValue=—}" />
                                </TextBlock>
                            </Border>
                        </WrapPanel>
                        <TextBlock Margin="0,0,0,0" Text="{Binding PreflightResult.Summary}"
                                   Style="{StaticResource Nexus.Text.Body}" TextWrapping="Wrap" />
                        <Border Style="{StaticResource NexusCard}" Margin="0,16,0,0"
                                Background="{DynamicResource Nexus.WarningSubtle}"
                                BorderBrush="{DynamicResource Nexus.Warning}"
                                BorderThickness="1">
                            <TextBlock Style="{StaticResource Nexus.Text.Caption}" TextWrapping="Wrap"
                                       Text="Not: Otomatik flash yalnızca ön kontroller geçerse ve kullanıcı risk onayı verirse başlatılmalıdır. Magisk.zip rename yöntemi kullanılmaz." />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
