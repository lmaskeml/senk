<UserControl x:Class="AndroidManager.Security.Views.StockRomFlashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource Nexus.Background}"
             d:DesignHeight="720" d:DesignWidth="960">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Style="{StaticResource NexusPageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="24,20,24,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Orijinal ROM yükleme" Style="{StaticResource Nexus.Text.H1}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Nexus.Text.Caption}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <ProgressBar Grid.Row="1" Height="3" IsIndeterminate="True" Margin="24,12,24,0"
                     Foreground="{DynamicResource Nexus.Primary}"
                     Background="Transparent" BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        <ScrollViewer Grid.Row="2" Style="{StaticResource NexusPageScroll}">
            <StackPanel MaxWidth="720">
                <Border Style="{StaticResource NexusCardElevated}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="NE YAPAR"
                                   Style="{StaticResource NexusSectionHeader}" />
                        <TextBlock Style="{StaticResource Nexus.Text.Caption}" TextWrapping="Wrap">
                            Xiaomi fastboot ROM klasörünü (Mi Flash ile aynı: images\boot.img, super.img) seçer.
                            flash_all.bat ve inject-twrp.sh bu klasöre kopyalanır.
                        </TextBlock>
                        <TextBlock Style="{StaticResource Nexus.Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0">
                            Faz 1: stock firmware + super + boot yazılır. TWRP boot bölümüne yazılmaz
                            (A/B cihazda sistem yerine recovery açılır).
                        </TextBlock>
                        <TextBlock Style="{StaticResource Nexus.Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0">
                            Faz 2: TWRP RAM'den açılır, stock kernel + TWRP ramdisk birleşir, Magisk varsa kurulur,
                            Format Data yapılır, sistem açılır. Tüm kullanıcı verisi silinir. Bootloader açık olmalı.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource NexusCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="ROM KLASÖRÜ"
                                   Style="{StaticResource NexusSectionHeader}" />
                        <TextBlock Text="{Binding FolderPath, TargetNullValue=Henüz seçilmedi}"
                                   Style="{StaticResource Nexus.Text.H2}"
                                   TextWrapping="Wrap" />
                        <WrapPanel Margin="0,12,0,0">
                            <Border Style="{StaticResource NexusStatusBadge}" Margin="0,0,8,8"
                                    Background="{DynamicResource Nexus.PrimarySubtle}">
                                <TextBlock Style="{StaticResource Nexus.Text.Caption}">
                                    <Run Text="boot: " />
                                    <Run Text="{Binding Folder.HasBoot, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource NexusStatusBadge}" Margin="0,0,8,8"
                                    Background="{DynamicResource Nexus.SurfaceElevated}">
                                <TextBlock Style="{StaticResource Nexus.Text.Caption}">
                                    <Run Text="super: " />
                                    <Run Text="{Binding Folder.HasSuper, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource NexusStatusBadge}" Margin="0,0,8,8"
                                    Background="{DynamicResource Nexus.SurfaceElevated}">
                                <TextBlock Style="{StaticResource Nexus.Text.Caption}">
                                    <Run Text="TWRP: " />
                                    <Run Text="{Binding Folder.HasTwrp, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource NexusStatusBadge}" Margin="0,0,8,8"
                                    Background="{DynamicResource Nexus.SurfaceElevated}">
                                <TextBlock Style="{StaticResource Nexus.Text.Caption}">
                                    <Run Text="Magisk: " />
                                    <Run Text="{Binding Folder.HasMagisk, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Command="{Binding PickFolderCommand}"
                                    Style="{StaticResource NexusPrimaryButton}"
                                    Margin="0,0,8,8"
                                    Content="Klasör seç" />
                            <Button Command="{Binding PickTwrpCommand}"
                                    Style="{StaticResource NexusSecondaryButton}"
                                    Margin="0,0,8,8"
                                    Content="TWRP .img ekle" />
                            <Button Command="{Binding PickMagiskCommand}"
                                    Style="{StaticResource NexusSecondaryButton}"
                                    Margin="0,0,8,8"
                                    Content="Magisk zip ekle" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Button Command="{Binding StartFlashCommand}"
                        Style="{StaticResource NexusPrimaryButton}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,16"
                        Content="Yüklemeyi başlat" />

                <Border Style="{StaticResource NexusCard}">
                    <StackPanel>
                        <TextBlock Text="LOG"
                                   Style="{StaticResource NexusSectionHeader}" />
                        <TextBox Text="{Binding ActivityLog, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Height="240"
                                 FontFamily="{DynamicResource Nexus.FontMono}"
                                 FontSize="12"
                                 Background="{DynamicResource Nexus.Surface}"
                                 Foreground="{DynamicResource Nexus.TextPrimary}"
                                 BorderBrush="{DynamicResource Nexus.Border}"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
