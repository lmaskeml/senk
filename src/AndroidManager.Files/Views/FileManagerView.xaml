<UserControl x:Class="AndroidManager.Files.Views.FileManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:b="clr-namespace:AndroidManager.Files.Behaviors"
             xmlns:c="clr-namespace:AndroidManager.Files.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{DynamicResource Nexus.Background}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <c:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ToolBarTray Grid.Row="0">
            <ToolBar>
                <Button Command="{Binding PullCommand}" ToolTip="Android → PC">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="ArrowDown" Margin="0,0,4,0" />
                        <TextBlock Text="İndir" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding PushCommand}" ToolTip="PC → Android">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="ArrowUp" Margin="0,0,4,0" />
                        <TextBlock Text="Gönder" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Separator />
                <Button Command="{Binding CreateFolderCommand}">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="FolderPlus" Margin="0,0,4,0" />
                        <TextBlock Text="Yeni Klasör" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RenameCommand}" ToolTip="Yeniden adlandır (F2)">
                    <md:PackIcon Kind="RenameBox" />
                </Button>
                <Button Command="{Binding DeleteAndroidItemCommand}" ToolTip="Sil (Delete)">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Delete" Margin="0,0,4,0" />
                        <TextBlock Text="Sil" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <Border Grid.Row="1"
                Padding="12,8"
                Background="{DynamicResource Nexus.SurfaceElevated}"
                BorderBrush="{DynamicResource Nexus.Border}"
                BorderThickness="0,0,0,1"
                Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding CurrentProgress.FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CurrentProgress.DetailText}"
                               Margin="0,2,0,0"
                               Opacity="0.75"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar Height="6" Margin="0,6,0,0" Maximum="100"
                                 IsIndeterminate="{Binding CurrentProgress.IsIndeterminate, Mode=OneWay}"
                                 Value="{Binding CurrentProgress.Percentage, Mode=OneWay}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                           FontWeight="SemiBold">
                    <Run Text="{Binding CurrentProgress.PercentLabel, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Android panel -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Margin="4,0,4,4"
                           Style="{StaticResource Nexus.Text.H3}" Text="Android" />
                <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Command="{Binding NavigateAndroidUpCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Üst klasör">
                        <md:PackIcon Kind="ArrowLeft" />
                    </Button>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding AndroidBreadcrumb}"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding Label}"
                                            Command="{Binding DataContext.NavigateAndroidCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Path}"
                                            Padding="4,0" MinWidth="0"
                                            Style="{StaticResource MaterialDesignFlatButton}" />
                                    <TextBlock Text="›" Margin="0,0,2,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <ListView ItemsSource="{Binding AndroidItems}"
                          SelectedItem="{Binding SelectedAndroidItem}"
                          SelectionMode="Extended"
                          VirtualizingPanel.IsVirtualizing="True"
                          MouseDoubleClick="AndroidList_OnMouseDoubleClick">
                    <i:Interaction.Behaviors>
                        <b:AndroidDragBehavior />
                        <b:DropCommandBehavior Command="{Binding DropToAndroidCommand}" />
                    </i:Interaction.Behaviors>
                    <ListView.InputBindings>
                        <KeyBinding Key="Delete" Command="{Binding DeleteAndroidItemCommand}" />
                        <KeyBinding Key="F2" Command="{Binding RenameCommand}" />
                    </ListView.InputBindings>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="36">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Icon}" FontSize="16" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Ad" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock Text="{Binding Name}"
                                                       Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVis}}" />
                                            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Return"
                                                                Command="{Binding DataContext.CommitRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Boyut" Width="80" DisplayMemberBinding="{Binding Size}" />
                            <GridViewColumn Header="Tür" Width="90" DisplayMemberBinding="{Binding TypeLabel}" />
                            <GridViewColumn Header="Değiştirilme" Width="120" DisplayMemberBinding="{Binding Modified}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="{DynamicResource Nexus.Border}" />

            <!-- PC panel -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Margin="4,0,4,4"
                           Style="{StaticResource Nexus.Text.H3}" Text="Bilgisayar" />
                <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Command="{Binding NavigatePcUpCommand}"
                            Style="{StaticResource MaterialDesignIconButton}">
                        <md:PackIcon Kind="ArrowLeft" />
                    </Button>
                    <TextBox Grid.Column="1"
                             Margin="4,0,0,0"
                             Text="{Binding PcCurrentPath, UpdateSourceTrigger=LostFocus}"
                             md:HintAssist.Hint="Klasör yolu"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return"
                                        Command="{Binding NavigatePcCommand}"
                                        CommandParameter="{Binding PcCurrentPath}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </Grid>

                <ListView ItemsSource="{Binding PcItems}"
                          SelectedItem="{Binding SelectedPcItem}"
                          SelectionMode="Extended"
                          VirtualizingPanel.IsVirtualizing="True"
                          MouseDoubleClick="PcList_OnMouseDoubleClick">
                    <i:Interaction.Behaviors>
                        <b:DropCommandBehavior Command="{Binding DropToPcCommand}" />
                    </i:Interaction.Behaviors>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="36">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Icon}" FontSize="16" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Ad" Width="200" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Boyut" Width="80" DisplayMemberBinding="{Binding SizeFormatted}" />
                            <GridViewColumn Header="Değiştirilme" Width="120" DisplayMemberBinding="{Binding ModifiedText}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Grid>

        <StatusBar Grid.Row="3" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="100" Height="4" IsIndeterminate="True"
                             Visibility="{Binding IsAndroidLoading, Converter={StaticResource BoolToVis}}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
