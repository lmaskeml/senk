<UserControl x:Class="AndroidManager.Files.Views.StorageAnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="960"
             Background="{DynamicResource Nexus.Background}"
             Foreground="{DynamicResource Nexus.TextPrimary}"
             TextElement.Foreground="{DynamicResource Nexus.TextPrimary}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Depolama Analizi"
                           Style="{StaticResource Nexus.Text.H1}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Nexus.Text.Caption}"
                           Foreground="{DynamicResource Nexus.TextSecondary}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"
                         Width="160" Padding="8,6" Margin="0,0,8,0"
                         VerticalAlignment="Center" FontFamily="Consolas"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                <Button Content="Analiz et"
                        Command="{Binding AnalyzeCommand}"
                        Style="{StaticResource NexusPrimaryButton}"
                        MinHeight="36"
                        Padding="14,8" />
            </StackPanel>
        </DockPanel>

        <ProgressBar Grid.Row="1" Height="3" IsIndeterminate="True" Margin="0,0,0,12"
                     Foreground="{DynamicResource Nexus.Primary}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource NexusCard}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Birim özeti" Style="{StaticResource Nexus.Text.H3}" Margin="0,0,0,8" />
                    <ProgressBar Maximum="100" Height="10"
                                 Value="{Binding UsedPercent, Mode=OneWay}"
                                 Foreground="{DynamicResource Nexus.Primary}" />
                    <TextBlock Text="{Binding VolumeSummary}"
                               Style="{StaticResource Nexus.Text.Body}"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock DockPanel.Dock="Top" Text="Klasör kullanımı"
                               Style="{StaticResource Nexus.Text.H3}" Margin="0,0,0,8" />
                    <ListView ItemsSource="{Binding Folders}"
                              SelectedItem="{Binding SelectedFolder}"
                              Foreground="{DynamicResource Nexus.TextPrimary}"
                              BorderBrush="{DynamicResource Nexus.Border}" BorderThickness="1"
                              Background="{DynamicResource Nexus.Surface}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Klasör" Width="160" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Boyut" Width="90" DisplayMemberBinding="{Binding SizeFormatted}" />
                                <GridViewColumn Header="% kullanılan" Width="90"
                                                DisplayMemberBinding="{Binding PercentOfUsed, StringFormat={}{0:0.0}%}" />
                                <GridViewColumn Header="Yol" Width="220" DisplayMemberBinding="{Binding Path}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>

                <DockPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock DockPanel.Dock="Top" Text="Büyük dosyalar (≥50 MB)"
                               Style="{StaticResource Nexus.Text.H3}" Margin="0,0,0,8" />
                    <ListView ItemsSource="{Binding LargeFiles}"
                              SelectedItem="{Binding SelectedLargeFile}"
                              Foreground="{DynamicResource Nexus.TextPrimary}"
                              BorderBrush="{DynamicResource Nexus.Border}" BorderThickness="1"
                              Background="{DynamicResource Nexus.Surface}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Dosya" Width="180" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Boyut" Width="90" DisplayMemberBinding="{Binding SizeFormatted}" />
                                <GridViewColumn Header="Yol" Width="280" DisplayMemberBinding="{Binding Path}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
