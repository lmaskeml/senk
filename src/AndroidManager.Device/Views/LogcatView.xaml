<UserControl x:Class="AndroidManager.Device.Views.LogcatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:AndroidManager.Device.Converters"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="960"
             Background="{DynamicResource Nexus.Background}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:LogcatLevelBrushConverter x:Key="LevelBrush" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Logcat Studio" Style="{StaticResource Nexus.Text.H1}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Nexus.Text.Caption}"
                           Foreground="{DynamicResource Nexus.TextSecondary}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Başlat" Command="{Binding StartCommand}"
                        Style="{StaticResource NexusPrimaryButton}" Margin="0,0,8,0" />
                <Button Content="Durdur" Command="{Binding StopCommand}"
                        Style="{StaticResource NexusSecondaryButton}" Margin="0,0,8,0" />
                <Button Content="Duraklat / Devam" Command="{Binding TogglePauseCommand}"
                        Style="{StaticResource NexusTertiaryButton}" Margin="0,0,8,0" />
                <Button Content="Listeyi temizle" Command="{Binding ClearLinesCommand}"
                        Style="{StaticResource NexusTertiaryButton}" Margin="0,0,8,0" />
                <Button Content="Cihaz log -c" Command="{Binding ClearDeviceCommand}"
                        Style="{StaticResource NexusTertiaryButton}" Margin="0,0,8,0" />
                <Button Content="Kaydet" Command="{Binding SaveCommand}"
                        Style="{StaticResource NexusSecondaryButton}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource NexusCard}" Margin="0,0,0,10">
            <WrapPanel>
                <StackPanel Margin="0,0,16,8" Width="140">
                    <TextBlock Text="Seviye" FontSize="11" Foreground="{DynamicResource Nexus.TextMuted}" />
                    <ComboBox ItemsSource="{Binding Levels}"
                              SelectedItem="{Binding MinLevel}"
                              Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Margin="0,0,16,8" Width="120">
                    <TextBlock Text="Buffer" FontSize="11" Foreground="{DynamicResource Nexus.TextMuted}" />
                    <ComboBox ItemsSource="{Binding Buffers}"
                              SelectedItem="{Binding SelectedBuffer}"
                              Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Margin="0,0,16,8" Width="160">
                    <TextBlock Text="Tag" FontSize="11" Foreground="{DynamicResource Nexus.TextMuted}" />
                    <TextBox Text="{Binding TagFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Padding="6,4" />
                </StackPanel>
                <StackPanel Margin="0,0,16,8" Width="220">
                    <TextBlock Text="Metin filtresi" FontSize="11" Foreground="{DynamicResource Nexus.TextMuted}" />
                    <TextBox Text="{Binding TextFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Padding="6,4" />
                </StackPanel>
                <CheckBox Content="Başlamadan önce temizle (-c)"
                          IsChecked="{Binding ClearBeforeStart}"
                          VerticalAlignment="Bottom"
                          Margin="0,0,0,10"
                          Foreground="{DynamicResource Nexus.TextSecondary}" />
            </WrapPanel>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource Nexus.SurfaceElevated}"
                CornerRadius="4"
                BorderBrush="{DynamicResource Nexus.Border}"
                BorderThickness="1">
            <ListBox ItemsSource="{Binding Lines}"
                     SelectedItem="{Binding SelectedLine}"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     Background="Transparent"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     FontSize="12">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,1">
                            <TextBlock DockPanel.Dock="Left" Width="18" FontWeight="Bold"
                                       Text="{Binding LevelLetter}"
                                       Foreground="{Binding Level, Converter={StaticResource LevelBrush}}" />
                            <TextBlock DockPanel.Dock="Left" Width="150"
                                       Foreground="{DynamicResource Nexus.TextMuted}"
                                       Text="{Binding Timestamp}" />
                            <TextBlock DockPanel.Dock="Left" Width="140"
                                       Foreground="{DynamicResource Nexus.Primary}"
                                       Text="{Binding Tag}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Message}"
                                       Foreground="{DynamicResource Nexus.TextPrimary}"
                                       TextWrapping="NoWrap" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
