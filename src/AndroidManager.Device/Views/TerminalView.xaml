<UserControl x:Class="AndroidManager.Device.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="960"
             Background="{DynamicResource Nexus.Background}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="ADB Terminal" Style="{StaticResource Nexus.Text.H1}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Nexus.Text.Caption}"
                           Foreground="{DynamicResource Nexus.TextSecondary}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Oturum aç" Command="{Binding OpenSessionCommand}"
                        Style="{StaticResource NexusPrimaryButton}" Margin="0,0,8,0" />
                <Button Content="Kapat" Command="{Binding CloseSessionCommand}"
                        Style="{StaticResource NexusSecondaryButton}" Margin="0,0,8,0" />
                <Button Content="Temizle" Command="{Binding ClearOutputCommand}"
                        Style="{StaticResource NexusTertiaryButton}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource Nexus.SurfaceElevated}"
                BorderBrush="{DynamicResource Nexus.Border}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8">
            <ScrollViewer x:Name="OutputScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBox Text="{Binding OutputText, Mode=OneWay}"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource Nexus.TextPrimary}"
                         FontFamily="Consolas"
                         FontSize="13"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True" />
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right"
                    Content="Gönder"
                    Command="{Binding SendCommand}"
                    Style="{StaticResource NexusPrimaryButton}"
                    MinWidth="100"
                    Margin="8,0,0,0" />
            <TextBox x:Name="CommandBox"
                     Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Consolas"
                     FontSize="14"
                     Padding="10,8"
                     KeyDown="CommandBox_OnKeyDown" />
        </DockPanel>
    </Grid>
</UserControl>
