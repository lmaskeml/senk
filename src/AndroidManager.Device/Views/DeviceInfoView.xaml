<UserControl x:Class="AndroidManager.Device.Views.DeviceInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:AndroidManager.Device.Converters"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="960"
             Background="{DynamicResource Nexus.Background}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <converters:MetricToBarHeightConverter x:Key="BarH" MaxHeight="40" MaxValue="100" />
        <converters:MetricToBarHeightConverter x:Key="TempBarH" MaxHeight="40" MaxValue="80" />
    </UserControl.Resources>

    <Grid Style="{StaticResource NexusPageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page toolbar -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="24,20,24,0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Cihaz Merkezi" Style="{StaticResource Nexus.Text.H1}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Nexus.Text.Caption}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="Canlı izleme"
                          IsChecked="{Binding IsLiveMonitoring}"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"
                          Foreground="{DynamicResource Nexus.TextSecondary}" />
                <Button Content="Raporu Kaydet"
                        Command="{Binding SaveReportCommand}"
                        Style="{StaticResource NexusSecondaryButton}"
                        Margin="0,0,8,0" />
                <Button Command="{Binding RefreshCommand}"
                        Style="{StaticResource NexusPrimaryButton}"
                        MinWidth="100">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="Yenile" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <ProgressBar Grid.Row="1"
                     Height="3"
                     Margin="24,12,24,0"
                     IsIndeterminate="True"
                     Foreground="{DynamicResource Nexus.Primary}"
                     Background="Transparent"
                     BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        <ScrollViewer Grid.Row="2" Style="{StaticResource NexusPageScroll}">
            <StackPanel>
                <!-- Empty state -->
                <StackPanel Style="{StaticResource NexusEmptyState}"
                            Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVis}}">
                    <materialDesign:PackIcon Kind="CellphoneOff"
                                             Width="48" Height="48"
                                             HorizontalAlignment="Center"
                                             Foreground="{DynamicResource Nexus.TextMuted}" />
                    <TextBlock Text="Bağlı cihaz yok"
                               Style="{StaticResource Nexus.Text.H3}"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,8" />
                    <TextBlock Text="USB veya Wi‑Fi ile bir Android cihaz bağlayın."
                               Style="{StaticResource Nexus.Text.Body}"
                               Foreground="{DynamicResource Nexus.TextSecondary}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">

                    <!-- 1. Device header -->
                    <Border Style="{StaticResource NexusCardElevated}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" LastChildFill="True">
                                <Border DockPanel.Dock="Right"
                                        Style="{StaticResource NexusStatusBadge}"
                                        VerticalAlignment="Top"
                                        Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Margin="0,0,6,0"
                                                 Fill="{DynamicResource Nexus.Success}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="Bağlı"
                                                   Style="{StaticResource NexusStatusBadgeText}" />
                                    </StackPanel>
                                </Border>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Nexus.Text.H2}">
                                        <Run Text="{Binding DeviceInfo.Manufacturer}" />
                                        <Run Text=" " />
                                        <Run Text="{Binding DeviceInfo.Model}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding DeviceInfo.Serial}"
                                               Style="{StaticResource Nexus.Text.Mono}"
                                               Margin="0,4,0,0" />
                                    <TextBlock Style="{StaticResource Nexus.Text.BodySmall}" Margin="0,6,0,0">
                                        <Run Text="{Binding DeviceInfo.AndroidVersion, StringFormat=Android {0}}" />
                                        <Run Text=" · API " />
                                        <Run Text="{Binding DeviceInfo.ApiLevel}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>

                            <!-- Summary chips: root / bootloader / threats / live patch -->
                            <WrapPanel Grid.Row="1" Margin="0,14,0,0">
                                <Border Background="{DynamicResource Nexus.PrimarySubtle}"
                                        CornerRadius="{DynamicResource Nexus.RadiusBadge}"
                                        Padding="10,5" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ShieldAccount" Width="14" Height="14"
                                                                 Margin="0,0,6,0" VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource Nexus.Primary}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Style="{StaticResource Nexus.Text.Caption}"
                                                   Foreground="{DynamicResource Nexus.TextPrimary}">
                                            <Run Text="Root: " />
                                            <Run Text="{Binding SecuritySummary.RootAccess, FallbackValue=—, TargetNullValue=—}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource Nexus.PrimarySubtle}"
                                        CornerRadius="{DynamicResource Nexus.RadiusBadge}"
                                        Padding="10,5" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="LockOpenVariant" Width="14" Height="14"
                                                                 Margin="0,0,6,0" VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource Nexus.Warning}" />
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Nexus.Text.Caption}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Nexus.TextPrimary}" />
                                                    <Setter Property="Text" Value="Bootloader: —" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SecuritySummary.BootloaderUnlocked}" Value="True">
                                                            <Setter Property="Text" Value="Bootloader: Açık" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SecuritySummary.BootloaderUnlocked}" Value="False">
                                                            <Setter Property="Text" Value="Bootloader: Kilitli" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource Nexus.PrimarySubtle}"
                                        CornerRadius="{DynamicResource Nexus.RadiusBadge}"
                                        Padding="10,5" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AlertOctagon" Width="14" Height="14"
                                                                 Margin="0,0,6,0" VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource Nexus.Danger}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Style="{StaticResource Nexus.Text.Caption}"
                                                   Foreground="{DynamicResource Nexus.TextPrimary}">
                                            <Run Text="Tehdit: " />
                                            <Run Text="{Binding SecuritySummary.ThreatCount, StringFormat={}{0}, FallbackValue=0, TargetNullValue=0}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource Nexus.PrimarySubtle}"
                                        CornerRadius="{DynamicResource Nexus.RadiusBadge}"
                                        Padding="10,5" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Security" Width="14" Height="14"
                                                                 Margin="0,0,6,0" VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource Nexus.Success}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Style="{StaticResource Nexus.Text.Caption}"
                                                   Foreground="{DynamicResource Nexus.TextPrimary}"
                                                   Text="{Binding Live.SecurityPatch, StringFormat=Yama: {0}, FallbackValue=Yama: —, TargetNullValue=Yama: —}" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource Nexus.PrimarySubtle}"
                                        CornerRadius="{DynamicResource Nexus.RadiusBadge}"
                                        Padding="10,5" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="KeyVariant" Width="14" Height="14"
                                                                 Margin="0,0,6,0" VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource Nexus.TextSecondary}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Style="{StaticResource Nexus.Text.Caption}"
                                                   Foreground="{DynamicResource Nexus.TextPrimary}"
                                                   Text="{Binding Live.BootloaderLocked, StringFormat=Live BL: {0}, FallbackValue=Live BL: —, TargetNullValue=Live BL: —}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <!-- Network / identity row -->
                            <UniformGrid Grid.Row="2" Columns="3" Margin="0,8,0,0">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Wi‑Fi IP" Style="{StaticResource Nexus.Text.Caption}" />
                                    <TextBlock Text="{Binding Live.WifiIp, TargetNullValue=—, FallbackValue=—}"
                                               Style="{StaticResource Nexus.Text.Mono}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="SSID / RSSI" Style="{StaticResource Nexus.Text.Caption}" />
                                    <TextBlock Text="{Binding Live.WifiSsid, TargetNullValue=—, FallbackValue=—}"
                                               Style="{StaticResource Nexus.Text.Body}"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Live.WifiRssiText, FallbackValue=—}"
                                               Style="{StaticResource Nexus.Text.MonoSmall}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Güvenlik yaması" Style="{StaticResource Nexus.Text.Caption}" />
                                    <TextBlock Text="{Binding Live.SecurityPatch, FallbackValue=—}"
                                               Style="{StaticResource Nexus.Text.Body}"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Live.BootloaderLocked, FallbackValue=—}"
                                               Style="{StaticResource Nexus.Text.Caption}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <!-- 2. Security card -->
                    <Border Style="{StaticResource NexusCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="ShieldCheck" Width="18" Height="18"
                                                         DockPanel.Dock="Left"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource Nexus.Primary}" />
                                <TextBlock Text="GÜVENLİK" Style="{StaticResource NexusSectionHeader}" Margin="0" />
                            </DockPanel>
                            <UniformGrid Columns="4">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Root" Style="{StaticResource Nexus.Text.Caption}" />
                                    <TextBlock Text="{Binding SecuritySummary.RootAccess, FallbackValue=—, TargetNullValue=—}"
                                               Style="{StaticResource Nexus.Text.H3}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Bootloader" Style="{StaticResource Nexus.Text.Caption}" />
                                    <TextBlock Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Nexus.Text.H3}">
                                                <Setter Property="Text" Value="—" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SecuritySummary.BootloaderUnlocked}" Value="True">
                                                        <Setter Property="Text" Value="Açık" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SecuritySummary.BootloaderUnlocked}" Value="False">
                                                        <Setter Property="Text" Value="Kilitli" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Tehditler" Style="{StaticResource Nexus.Text.Caption}" />
                                    <TextBlock Text="{Binding SecuritySummary.ThreatCount, StringFormat={}{0}, FallbackValue=0, TargetNullValue=0}"
                                               Style="{StaticResource Nexus.Text.H3}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Son tarama" Style="{StaticResource Nexus.Text.Caption}" />
                                    <TextBlock Text="{Binding SecuritySummary.LastScanAt, StringFormat={}{0:g}, TargetNullValue=Henüz yok, FallbackValue=Henüz yok}"
                                               Style="{StaticResource Nexus.Text.Body}"
                                               Margin="0,4,0,0" />
                                    <TextBlock Style="{StaticResource Nexus.Text.Caption}"
                                               Margin="0,4,0,0"
                                               Text="{Binding DeepScanLabel}" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Margin="0,12,0,0"
                                       Style="{StaticResource Nexus.Text.Caption}"
                                       Text="{Binding SecuritySummary.PlayIntegrity, StringFormat=Play Integrity: {0}, FallbackValue=Play Integrity: Bilinmiyor, TargetNullValue=Play Integrity: Bilinmiyor}" />
                        </StackPanel>
                    </Border>

                    <!-- 3. Live metrics -->
                    <TextBlock Text="CANLI METRİKLER" Style="{StaticResource NexusSectionHeader}" />
                    <UniformGrid Columns="4" Margin="0,0,0,16">
                        <Border Style="{StaticResource NexusMetricCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <DockPanel>
                                    <materialDesign:PackIcon Kind="Cpu64Bit" Width="16" Height="16"
                                                             DockPanel.Dock="Right"
                                                             Foreground="{DynamicResource Nexus.Primary}" />
                                    <TextBlock Text="CPU" Style="{StaticResource Nexus.Text.H3}" />
                                </DockPanel>
                                <ProgressBar Maximum="100" Height="6" Margin="0,10,0,6"
                                             Value="{Binding Live.CpuPercent, FallbackValue=0}"
                                             Foreground="{DynamicResource Nexus.Primary}"
                                             Background="{DynamicResource Nexus.PrimarySubtle}"
                                             BorderThickness="0" />
                                <TextBlock Text="{Binding Live.CpuPercent, StringFormat={}{0:0}%, FallbackValue=—}"
                                           Style="{StaticResource Nexus.Text.Body}" />
                                <ItemsControl ItemsSource="{Binding CpuHistory}" Height="44" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="4" Margin="1,0"
                                                    Background="{DynamicResource Nexus.Primary}"
                                                    VerticalAlignment="Bottom"
                                                    Height="{Binding Converter={StaticResource BarH}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource NexusMetricCard}" Margin="4,0">
                            <StackPanel>
                                <DockPanel>
                                    <materialDesign:PackIcon Kind="Memory" Width="16" Height="16"
                                                             DockPanel.Dock="Right"
                                                             Foreground="{DynamicResource Nexus.Primary}" />
                                    <TextBlock Text="RAM" Style="{StaticResource Nexus.Text.H3}" />
                                </DockPanel>
                                <ProgressBar Maximum="100" Height="6" Margin="0,10,0,6"
                                             Value="{Binding Live.RamPercent, FallbackValue=0}"
                                             Foreground="{DynamicResource Nexus.Primary}"
                                             Background="{DynamicResource Nexus.PrimarySubtle}"
                                             BorderThickness="0" />
                                <TextBlock Text="{Binding Live.RamPercent, StringFormat={}{0:0}%, FallbackValue=—}"
                                           Style="{StaticResource Nexus.Text.Body}" />
                                <ItemsControl ItemsSource="{Binding RamHistory}" Height="44" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="4" Margin="1,0"
                                                    Background="{DynamicResource Nexus.Primary}"
                                                    VerticalAlignment="Bottom"
                                                    Height="{Binding Converter={StaticResource BarH}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource NexusMetricCard}" Margin="4,0">
                            <StackPanel>
                                <DockPanel>
                                    <materialDesign:PackIcon Kind="Thermometer" Width="16" Height="16"
                                                             DockPanel.Dock="Right"
                                                             Foreground="{DynamicResource Nexus.Warning}" />
                                    <TextBlock Text="Sıcaklık" Style="{StaticResource Nexus.Text.H3}" />
                                </DockPanel>
                                <ProgressBar Maximum="80" Height="6" Margin="0,10,0,6"
                                             Value="{Binding Live.TemperatureC, FallbackValue=0}"
                                             Foreground="{DynamicResource Nexus.Warning}"
                                             Background="{DynamicResource Nexus.PrimarySubtle}"
                                             BorderThickness="0" />
                                <TextBlock Text="{Binding Live.TemperatureC, StringFormat={}{0:0.0} °C, FallbackValue=—}"
                                           Style="{StaticResource Nexus.Text.Body}" />
                                <ItemsControl ItemsSource="{Binding TempHistory}" Height="44" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="4" Margin="1,0"
                                                    Background="{DynamicResource Nexus.Warning}"
                                                    VerticalAlignment="Bottom"
                                                    Height="{Binding Converter={StaticResource TempBarH}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource NexusMetricCard}" Margin="8,0,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <materialDesign:PackIcon Kind="Battery" Width="16" Height="16"
                                                             DockPanel.Dock="Right"
                                                             Foreground="{DynamicResource Nexus.Success}" />
                                    <TextBlock Text="Pil" Style="{StaticResource Nexus.Text.H3}" />
                                </DockPanel>
                                <ProgressBar Maximum="100" Height="6" Margin="0,10,0,6"
                                             Value="{Binding Live.BatteryPercent, FallbackValue=0}"
                                             Foreground="{DynamicResource Nexus.Success}"
                                             Background="{DynamicResource Nexus.PrimarySubtle}"
                                             BorderThickness="0" />
                                <TextBlock Text="{Binding Live.BatteryPercent, StringFormat={}{0}%, FallbackValue=—}"
                                           Style="{StaticResource Nexus.Text.Body}" />
                                <TextBlock Text="{Binding Live.VoltageMv, StringFormat={}{0} mV, FallbackValue=—}"
                                           Style="{StaticResource Nexus.Text.Caption}"
                                           Margin="0,2,0,0" />
                                <TextBlock Text="Şarj oluyor"
                                           Style="{StaticResource Nexus.Text.Caption}"
                                           Foreground="{DynamicResource Nexus.Success}"
                                           Visibility="{Binding Live.IsCharging, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding BatteryHistory}" Height="44" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="4" Margin="1,0"
                                                    Background="{DynamicResource Nexus.Success}"
                                                    VerticalAlignment="Bottom"
                                                    Height="{Binding Converter={StaticResource BarH}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- 4. Quick Actions -->
                    <TextBlock Text="HIZLI ARAÇLAR" Style="{StaticResource NexusSectionHeader}" />
                    <Border Style="{StaticResource NexusCard}" Margin="0,0,0,8" Padding="12">
                        <UniformGrid Columns="4" Rows="3">
                            <Button Style="{StaticResource NexusQuickAction}"
                                    Command="{Binding RebootCommand}"
                                    Margin="4"
                                    ToolTip="Yeniden başlat">
                                <StackPanel>
                                    <materialDesign:PackIcon Kind="Restart" Width="22" Height="22"
                                                             HorizontalAlignment="Center"
                                                             Foreground="{DynamicResource Nexus.Primary}" />
                                    <TextBlock Text="Yeniden başlat" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NexusQuickAction}"
                                    Command="{Binding RebootRecoveryCommand}"
                                    Margin="4"
                                    ToolTip="Recovery">
                                <StackPanel>
                                    <materialDesign:PackIcon Kind="MedicalBag" Width="22" Height="22"
                                                             HorizontalAlignment="Center"
                                                             Foreground="{DynamicResource Nexus.Warning}" />
                                    <TextBlock Text="Recovery" Margin="0,8,0,0" TextAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NexusQuickAction}"
                                    Command="{Binding RebootBootloaderCommand}"
                                    Margin="4"
                                    ToolTip="Bootloader">
                                <StackPanel>
                                    <materialDesign:PackIcon Kind="Chip" Width="22" Height="22"
                                                             HorizontalAlignment="Center"
                                                             Foreground="{DynamicResource Nexus.TextSecondary}" />
                                    <TextBlock Text="Bootloader" Margin="0,8,0,0" TextAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NexusQuickAction}"
                                    Command="{Binding LockScreenCommand}"
                                    Margin="4"
                                    ToolTip="Ekranı kilitle">
                                <StackPanel>
                                    <materialDesign:PackIcon Kind="Lock" Width="22" Height="22"
                                                             HorizontalAlignment="Center"
                                                             Foreground="{DynamicResource Nexus.Primary}" />
                                    <TextBlock Text="Ekranı kilitle" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NexusQuickAction}"
                                    Command="{Binding ToggleStayAwakeCommand}"
                                    Margin="4"
                                    ToolTip="{Binding StayAwakeLabel}">
                                <StackPanel>
                                    <materialDesign:PackIcon Kind="Eye" Width="22" Height="22"
                                                             HorizontalAlignment="Center"
                                                             Foreground="{DynamicResource Nexus.Primary}" />
                                    <TextBlock Text="{Binding StayAwakeLabel}" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NexusQuickAction}"
                                    Command="{Binding ScreenshotCommand}"
                                    Margin="4"
                                    ToolTip="Ekran görüntüsü">
                                <StackPanel>
                                    <materialDesign:PackIcon Kind="MonitorScreenshot" Width="22" Height="22"
                                                             HorizontalAlignment="Center"
                                                             Foreground="{DynamicResource Nexus.Primary}" />
                                    <TextBlock Text="Ekran görüntüsü" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NexusQuickAction}"
                                    Command="{Binding WifiOnCommand}"
                                    Margin="4"
                                    ToolTip="Wi‑Fi aç">
                                <StackPanel>
                                    <materialDesign:PackIcon Kind="Wifi" Width="22" Height="22"
                                                             HorizontalAlignment="Center"
                                                             Foreground="{DynamicResource Nexus.Success}" />
                                    <TextBlock Text="Wi‑Fi aç" Margin="0,8,0,0" TextAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NexusQuickAction}"
                                    Command="{Binding WifiOffCommand}"
                                    Margin="4"
                                    ToolTip="Wi‑Fi kapat">
                                <StackPanel>
                                    <materialDesign:PackIcon Kind="WifiOff" Width="22" Height="22"
                                                             HorizontalAlignment="Center"
                                                             Foreground="{DynamicResource Nexus.Danger}" />
                                    <TextBlock Text="Wi‑Fi kapat" Margin="0,8,0,0" TextAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NexusQuickAction}"
                                    Command="{Binding BluetoothOnCommand}"
                                    Margin="4"
                                    ToolTip="BT aç">
                                <StackPanel>
                                    <materialDesign:PackIcon Kind="Bluetooth" Width="22" Height="22"
                                                             HorizontalAlignment="Center"
                                                             Foreground="{DynamicResource Nexus.Success}" />
                                    <TextBlock Text="BT aç" Margin="0,8,0,0" TextAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NexusQuickAction}"
                                    Command="{Binding BluetoothOffCommand}"
                                    Margin="4"
                                    ToolTip="BT kapat">
                                <StackPanel>
                                    <materialDesign:PackIcon Kind="BluetoothOff" Width="22" Height="22"
                                                             HorizontalAlignment="Center"
                                                             Foreground="{DynamicResource Nexus.Danger}" />
                                    <TextBlock Text="BT kapat" Margin="0,8,0,0" TextAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NexusQuickAction}"
                                    Command="{Binding ClipboardFromDeviceCommand}"
                                    Margin="4"
                                    ToolTip="Clipboard ← Android">
                                <StackPanel>
                                    <materialDesign:PackIcon Kind="ClipboardArrowDown" Width="22" Height="22"
                                                             HorizontalAlignment="Center"
                                                             Foreground="{DynamicResource Nexus.Primary}" />
                                    <TextBlock Text="Clipboard ← Android" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NexusQuickAction}"
                                    Command="{Binding ClipboardToDeviceCommand}"
                                    Margin="4"
                                    ToolTip="Clipboard → Android">
                                <StackPanel>
                                    <materialDesign:PackIcon Kind="ClipboardArrowUp" Width="22" Height="22"
                                                             HorizontalAlignment="Center"
                                                             Foreground="{DynamicResource Nexus.Primary}" />
                                    <TextBlock Text="Clipboard → Android" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </Border>
                    <TextBlock Text="{Binding ClipboardPreview, StringFormat=Pano önizleme: {0}}"
                               Style="{StaticResource Nexus.Text.Caption}"
                               Margin="0,0,0,16"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasClipboardPreview, Converter={StaticResource BoolToVis}}" />

                    <!-- 5. Storage + RAM -->
                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <Border Style="{StaticResource NexusCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="Harddisk" Width="16" Height="16"
                                                             DockPanel.Dock="Right"
                                                             Foreground="{DynamicResource Nexus.Primary}" />
                                    <TextBlock Text="Depolama" Style="{StaticResource Nexus.Text.H3}" />
                                </DockPanel>
                                <ProgressBar Maximum="100" Height="8"
                                             Value="{Binding DeviceInfo.Storage.UsagePercent, Mode=OneWay}"
                                             Foreground="{DynamicResource Nexus.Primary}"
                                             Background="{DynamicResource Nexus.PrimarySubtle}"
                                             BorderThickness="0" />
                                <TextBlock Margin="0,10,0,0"
                                           Style="{StaticResource Nexus.Text.Body}"
                                           Text="{Binding DeviceInfo.Storage.UsedFormatted}" />
                                <TextBlock Style="{StaticResource Nexus.Text.Caption}"
                                           Margin="0,4,0,0"
                                           Text="{Binding DeviceInfo.Storage.TotalFormatted, StringFormat=Toplam {0}}" />
                                <TextBlock Style="{StaticResource Nexus.Text.Caption}"
                                           Text="{Binding DeviceInfo.Storage.FreeFormatted, StringFormat=Boş {0}}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource NexusCard}" Margin="8,0,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="Memory" Width="16" Height="16"
                                                             DockPanel.Dock="Right"
                                                             Foreground="{DynamicResource Nexus.Primary}" />
                                    <TextBlock Text="RAM" Style="{StaticResource Nexus.Text.H3}" />
                                </DockPanel>
                                <ProgressBar Maximum="100" Height="8"
                                             Value="{Binding Live.RamPercent, Mode=OneWay, FallbackValue=0}"
                                             Foreground="{DynamicResource Nexus.Primary}"
                                             Background="{DynamicResource Nexus.PrimarySubtle}"
                                             BorderThickness="0" />
                                <TextBlock Margin="0,10,0,0"
                                           Style="{StaticResource Nexus.Text.Body}"
                                           Text="{Binding Live.RamUsedFormatted, FallbackValue=—}" />
                                <TextBlock Style="{StaticResource Nexus.Text.Caption}"
                                           Margin="0,4,0,0"
                                           Text="{Binding Live.RamTotalFormatted, StringFormat=Toplam {0}, FallbackValue=Toplam —}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- 6. Diagnostics -->
                    <TextBlock Text="TANI" Style="{StaticResource NexusSectionHeader}" />
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <Border Style="{StaticResource NexusCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="BatteryHeart" Width="16" Height="16"
                                                             DockPanel.Dock="Right"
                                                             Foreground="{DynamicResource Nexus.Success}" />
                                    <TextBlock Text="Pil sağlığı" Style="{StaticResource Nexus.Text.H3}" />
                                </DockPanel>
                                <TextBlock Text="{Binding Diagnostics.Battery.Health, FallbackValue=—}"
                                           Style="{StaticResource Nexus.Text.H2}" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource Nexus.Text.Caption}"
                                           Text="{Binding Diagnostics.Status, StringFormat=Durum: {0}, FallbackValue=Durum: —}" />
                                <TextBlock Style="{StaticResource Nexus.Text.Caption}"
                                           Text="{Binding Diagnostics.Technology, StringFormat=Teknoloji: {0}, FallbackValue=Teknoloji: —}" />
                                <TextBlock Style="{StaticResource Nexus.Text.Caption}"
                                           Text="{Binding Diagnostics.CycleCount, StringFormat=Şarj döngüsü: {0}, FallbackValue=Şarj döngüsü: —}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource NexusCard}" Margin="8,0,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="AccessPoint" Width="16" Height="16"
                                                             DockPanel.Dock="Right"
                                                             Foreground="{DynamicResource Nexus.Primary}" />
                                    <TextBlock Text="Sensör özeti" Style="{StaticResource Nexus.Text.H3}" />
                                </DockPanel>
                                <TextBlock Text="{Binding SensorsSummary}"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource Nexus.Text.Body}"
                                           Foreground="{DynamicResource Nexus.TextSecondary}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
