<UserControl x:Class="AndroidManager.Device.Views.BootControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:AndroidManager.Device.Converters"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="960"
             Background="{DynamicResource Nexus.Background}"
             Foreground="{DynamicResource Nexus.TextPrimary}"
             TextElement.Foreground="{DynamicResource Nexus.TextPrimary}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Boot Control"
                           Style="{StaticResource Nexus.Text.H1}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Nexus.Text.Caption}"
                           Foreground="{DynamicResource Nexus.TextSecondary}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <Button DockPanel.Dock="Right"
                    Content="Yenile"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource NexusPrimaryButton}"
                    MinHeight="36"
                    Padding="14,8"
                    VerticalAlignment="Center" />
        </DockPanel>

        <ProgressBar Grid.Row="1"
                     Height="3"
                     IsIndeterminate="True"
                     Foreground="{DynamicResource Nexus.Primary}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                     Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="2" Style="{StaticResource NexusPageScroll}" Padding="0">
            <StackPanel>
                <TextBlock Text="Bağlı cihaz yok."
                           Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVis}}"
                           HorizontalAlignment="Center"
                           Margin="0,40,0,0"
                           Foreground="{DynamicResource Nexus.TextMuted}" />

                <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Boot durumu" Style="{StaticResource Nexus.Text.H2}" Margin="0,0,0,8" />
                    <Border Style="{StaticResource NexusCard}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,12">
                                <TextBlock Text="Seri" Foreground="{DynamicResource Nexus.TextMuted}" FontSize="11" />
                                <TextBlock Text="{Binding Status.Serial}" FontFamily="Consolas" FontSize="14" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,12">
                                <TextBlock Text="Boot mode" Foreground="{DynamicResource Nexus.TextMuted}" FontSize="11" />
                                <TextBlock Text="{Binding Status.BootMode}" FontSize="14" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Boot reason" Foreground="{DynamicResource Nexus.TextMuted}" FontSize="11" />
                                <TextBlock Text="{Binding Status.BootReason}" FontSize="14" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Verified boot" Foreground="{DynamicResource Nexus.TextMuted}" FontSize="11" />
                                <TextBlock Text="{Binding Status.VerifiedBootState}" FontSize="14" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="Flash / bootloader" Foreground="{DynamicResource Nexus.TextMuted}" FontSize="11" />
                                <TextBlock Text="{Binding Status.FlashLocked}" FontSize="14" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="Güvenlik yaması" Foreground="{DynamicResource Nexus.TextMuted}" FontSize="11" />
                                <TextBlock Text="{Binding Status.SecurityPatch}" FontSize="14" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="Kontroller" Style="{StaticResource Nexus.Text.H2}" Margin="0,0,0,8" />
                    <Border Style="{StaticResource NexusCard}">
                        <WrapPanel>
                            <Button Content="Yeniden başlat"
                                    Command="{Binding RebootSystemCommand}"
                                    Style="{StaticResource NexusPrimaryButton}"
                                    MinHeight="40" MinWidth="160"
                                    Padding="16,10" Margin="0,0,10,10" />
                            <Button Content="Recovery"
                                    Command="{Binding RebootRecoveryCommand}"
                                    Style="{StaticResource NexusSecondaryButton}"
                                    MinHeight="40" MinWidth="140"
                                    Padding="16,10" Margin="0,0,10,10" />
                            <Button Content="Bootloader / Fastboot"
                                    Command="{Binding RebootBootloaderCommand}"
                                    Style="{StaticResource NexusSecondaryButton}"
                                    MinHeight="40" MinWidth="180"
                                    Padding="16,10" Margin="0,0,10,10" />
                            <Button Content="Kapat (power off)"
                                    Command="{Binding PowerOffCommand}"
                                    Style="{StaticResource NexusSecondaryButton}"
                                    MinHeight="40" MinWidth="160"
                                    Padding="16,10" Margin="0,0,10,10" />
                            <Button Content="Yumuşak reboot (zygote)"
                                    Command="{Binding SoftRebootCommand}"
                                    Style="{StaticResource NexusTertiaryButton}"
                                    MinHeight="40" MinWidth="200"
                                    Padding="16,10" Margin="0,0,10,10" />
                        </WrapPanel>
                    </Border>
                    <TextBlock Margin="0,12,0,0"
                               Foreground="{DynamicResource Nexus.TextMuted}"
                               FontSize="12" TextWrapping="Wrap"
                               Text="Uyarı: Recovery / Bootloader / kapatma işlemleri cihazın ADB bağlantısını keser. Yumuşak reboot çoğu stok ROM'da root ister." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
