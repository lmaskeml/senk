<UserControl x:Class="AndroidManager.Gallery.Views.GalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:vm="clr-namespace:AndroidManager.Gallery.ViewModels"
             xmlns:converters="clr-namespace:AndroidManager.Gallery.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{DynamicResource Nexus.Background}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Nexus.SurfaceElevated}"
                BorderBrush="{DynamicResource Nexus.Border}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ComboBox Width="140"
                              Margin="0,0,8,0"
                              ItemsSource="{Binding ViewModes}"
                              SelectedItem="{Binding ViewMode}"
                              VerticalAlignment="Center" />
                    <ComboBox Width="140"
                              Margin="0,0,8,0"
                              ItemsSource="{Binding FilterModes}"
                              SelectedItem="{Binding FilterMode}"
                              VerticalAlignment="Center" />
                    <Button Command="{Binding OpenPreviewCommand}"
                            CommandParameter="{Binding SelectedItem}"
                            Style="{StaticResource NexusSecondaryButton}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="PlayCircleOutline" Margin="0,0,4,0" />
                            <TextBlock Text="Önizle" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveToPcCommand}"
                            CommandParameter="{Binding SelectedItem}"
                            Style="{StaticResource NexusSecondaryButton}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Download" Margin="0,0,4,0" />
                            <TextBlock Text="Kaydet" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource NexusPrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Refresh" Margin="0,0,4,0" />
                            <TextBlock Text="Yenile" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Galeri" Style="{StaticResource Nexus.Text.H1}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource Nexus.TextSecondary}"
                               FontSize="12" Margin="0,4,0,0" />
                    <TextBlock Text="MediaStore üzerinden listelenir; küçük resimler yalnızca görünür öğeler için çekilir."
                               Foreground="{DynamicResource Nexus.TextMuted}"
                               FontSize="11" Margin="0,4,16,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <ListBox x:Name="MediaList"
                     ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem}"
                     BorderThickness="0"
                     Background="Transparent"
                     Visibility="{Binding IsGridMode, Converter={StaticResource BoolToVis}}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     MouseDoubleClick="MediaList_OnMouseDoubleClick"
                     RequestBringIntoView="MediaList_OnRequestBringIntoView">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel SpacingMode="None" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GalleryItemViewModel}">
                        <Border Width="168" Height="200"
                                Background="{DynamicResource Nexus.Surface}"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource Nexus.Border}"
                                BorderThickness="1"
                                Loaded="MediaItem_OnLoaded"
                                ToolTip="{Binding Subtitle}">
                            <Grid>
                                <Image Source="{Binding Thumbnail}"
                                       Stretch="UniformToFill"
                                       Margin="0,0,0,36" />
                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,36">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <md:PackIcon Width="36" Height="36"
                                                 Foreground="{DynamicResource Nexus.TextMuted}"
                                                 HorizontalAlignment="Center">
                                        <md:PackIcon.Style>
                                            <Style TargetType="md:PackIcon">
                                                <Setter Property="Kind" Value="ImageOutline" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                                        <Setter Property="Kind" Value="VideoOutline" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </md:PackIcon.Style>
                                    </md:PackIcon>
                                    <TextBlock Text="yükleniyor…"
                                               FontSize="11"
                                               Foreground="{DynamicResource Nexus.TextMuted}"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0"
                                               Visibility="{Binding IsLoadingThumbnail, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <Border Background="#CC1E1E28"
                                        CornerRadius="0,0,8,8"
                                        VerticalAlignment="Bottom"
                                        Padding="8,6">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right"
                                                Background="{DynamicResource Nexus.Success}"
                                                CornerRadius="3"
                                                Padding="4,1"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="VIDEO" FontSize="9" Foreground="White" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Visibility="{Binding IsTimelineMode, Converter={StaticResource BoolToVis}}"
                          VerticalScrollBarVisibility="Auto"
                          Padding="8">
                <ItemsControl ItemsSource="{Binding TimelineGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GalleryTimelineGroup}">
                            <StackPanel Margin="0,0,0,16">
                                <DockPanel Margin="8,8,8,10">
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding Count, StringFormat={}{0} öğe}"
                                               Foreground="{DynamicResource Nexus.TextMuted}"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GalleryItemViewModel}">
                                            <Border Width="140" Height="168"
                                                    Background="{DynamicResource Nexus.Surface}"
                                                    CornerRadius="8"
                                                    BorderBrush="{DynamicResource Nexus.Border}"
                                                    BorderThickness="1"
                                                    Margin="6"
                                                    Loaded="MediaItem_OnLoaded"
                                                    MouseLeftButtonDown="TimelineItem_OnMouseLeftButtonDown"
                                                    ToolTip="{Binding Subtitle}">
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" Margin="0,0,0,28" />
                                                    <Border Background="#CC1E1E28" CornerRadius="0,0,8,8"
                                                            VerticalAlignment="Bottom" Padding="6,4">
                                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="10"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Background="{DynamicResource Nexus.Surface}"
                    Opacity="0.85"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="220" Height="4"
                                 Foreground="{DynamicResource Nexus.Primary}" />
                    <TextBlock Text="İşleniyor…" Margin="0,12,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Nexus.TextSecondary}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource Nexus.SurfaceElevated}"
                BorderBrush="{DynamicResource Nexus.Border}"
                BorderThickness="0,1,0,0" Padding="12,8">
            <TextBlock FontSize="11" Foreground="{DynamicResource Nexus.TextMuted}">
                <Run Text="{Binding LoadedCount, Mode=OneWay}" />
                <Run Text=" öğe listelendi · çift tıkla önizle" />
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
