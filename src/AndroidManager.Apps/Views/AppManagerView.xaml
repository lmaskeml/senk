<UserControl x:Class="AndroidManager.Apps.Views.AppManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:c="clr-namespace:AndroidManager.Apps.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{DynamicResource Nexus.Background}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <c:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <c:NullToBooleanConverter x:Key="NullToBool" />
    </UserControl.Resources>

    <TabControl Margin="8" SelectedIndex="{Binding SelectedTabIndex}">
        <TabItem Header="Uygulamalar">
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ToolBarTray Grid.Row="0">
                    <ToolBar>
                        <Button Command="{Binding LoadAppsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Refresh" Margin="0,0,4,0" />
                                <TextBlock Text="Yenile" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding InstallApkCommand}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="PackageDown" Margin="0,0,4,0" />
                                <TextBlock Text="APK / XAPK Yükle" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Separator />
                        <TextBlock Text="veya .apk / .xapk / .apks / .apkm sürükleyip bırakın"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Nexus.TextMuted}"
                                   FontSize="11"
                                   Margin="8,0" />
                        <Separator />
                        <Button Command="{Binding UninstallCommand}"
                                IsEnabled="{Binding SelectedApp, Converter={StaticResource NullToBool}}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Delete" Margin="0,0,4,0" />
                                <TextBlock Text="Kaldır" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExtractApkCommand}"
                                IsEnabled="{Binding SelectedApp, Converter={StaticResource NullToBool}}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Download" Margin="0,0,4,0" />
                                <TextBlock Text="APK Yedekle" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ForceStopCommand}"
                                ToolTip="Force Stop"
                                IsEnabled="{Binding SelectedApp, Converter={StaticResource NullToBool}}">
                            <md:PackIcon Kind="Stop" />
                        </Button>
                        <Button Command="{Binding ClearDataCommand}"
                                ToolTip="Veri Temizle"
                                IsEnabled="{Binding SelectedApp, Converter={StaticResource NullToBool}}">
                            <md:PackIcon Kind="Broom" />
                        </Button>
                    </ToolBar>
                </ToolBarTray>

                <Grid Grid.Row="1" Margin="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="Uygulama ara (ad veya paket)"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                    <ToggleButton Grid.Column="1"
                                  Margin="12,0,0,0"
                                  IsChecked="{Binding IncludeSystem}"
                                  Style="{StaticResource MaterialDesignFlatToggleButton}"
                                  ToolTip="Sistem uygulamalarını göster">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Android" Margin="0,0,4,0" />
                            <TextBlock Text="Sistem" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                </Grid>

                <ProgressBar Grid.Row="2"
                             Height="8"
                             Maximum="100"
                             Value="{Binding InstallProgress}"
                             Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}" />

                <ListView Grid.Row="3"
                          Margin="0,8,0,0"
                          ItemsSource="{Binding Apps}"
                          SelectedItem="{Binding SelectedApp}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          MouseDoubleClick="AppsList_OnMouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="52">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Width="36" Height="36">
                                            <Border Background="{DynamicResource Nexus.Primary}"
                                                    CornerRadius="18"
                                                    Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVis}}">
                                                <TextBlock Text="{Binding InitialLetter}"
                                                           Foreground="White"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Image Source="{Binding Icon}"
                                                   Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Uygulama" Width="240">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding PackageName}" FontSize="11"
                                                       Foreground="{DynamicResource Nexus.TextMuted}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Sürüm" Width="90" DisplayMemberBinding="{Binding VersionName}" />
                            <GridViewColumn Header="Boyut" Width="80" DisplayMemberBinding="{Binding ApkSize}" />
                            <GridViewColumn Header="Kurulum" Width="100" DisplayMemberBinding="{Binding InstallDate}" />
                            <GridViewColumn Header="Tür" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Nexus.PrimarySubtle}" CornerRadius="4" Padding="6,2"
                                                Visibility="{Binding IsSystemApp, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="SİSTEM" FontSize="10" Foreground="{DynamicResource Nexus.Primary}" />
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <StatusBar Grid.Row="4">
                    <StatusBarItem>
                        <TextBlock Text="{Binding StatusMessage}" />
                    </StatusBarItem>
                    <StatusBarItem HorizontalAlignment="Right">
                        <ProgressBar Width="80" Height="4" IsIndeterminate="True"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                    </StatusBarItem>
                </StatusBar>
            </Grid>
        </TabItem>

        <TabItem Header="DeBloater">
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Nexus.Danger}" Padding="12,8" Margin="0,0,0,8" CornerRadius="4">
                    <DockPanel>
                        <md:PackIcon Kind="AlertCircle" Foreground="White" Margin="0,0,8,0"
                                     VerticalAlignment="Center" DockPanel.Dock="Left" />
                        <TextBlock Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center">
                            <Run FontWeight="Bold" Text="Dikkat: " />
                            <Run Text="Sistem uygulamalarını kaldırmak cihaz işlevini bozabilir. 'Güvenli' risktekilerden başlayın." />
                        </TextBlock>
                    </DockPanel>
                </Border>

                <DockPanel Grid.Row="1" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right"
                            Command="{Binding LoadDebloatCommand}"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Refresh" Margin="0,0,4,0" />
                            <TextBlock Text="Adayları Yenile" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="Sistem / bloat uygulamaları (root yok)"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Kaldır = pm uninstall -k --user 0 · Devre dışı = pm disable-user · Etkinleştir = geri yükle"
                                   FontSize="12" Foreground="{DynamicResource Nexus.TextSecondary}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Text="{Binding DebloatSearchText, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="DeBloater ara"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                    <ComboBox Grid.Column="1"
                              Margin="8,0,0,0"
                              ItemsSource="{Binding DebloatCategories}"
                              SelectedItem="{Binding DebloatCategory}"
                              md:HintAssist.Hint="Kategori" />

                    <CheckBox Grid.Column="2"
                              Margin="12,0,8,0"
                              VerticalAlignment="Center"
                              Content="Sadece pasifler"
                              IsChecked="{Binding ShowDisabledOnly}" />

                    <Button Grid.Column="3"
                            Command="{Binding RestoreDebloatCommand}"
                            IsEnabled="{Binding SelectedDebloat, Converter={StaticResource NullToBool}}"
                            Padding="10,6" Margin="4,0,0,0"
                            Content="Etkinleştir" />
                    <Button Grid.Column="4"
                            Command="{Binding DisableUserDebloatCommand}"
                            IsEnabled="{Binding SelectedDebloat, Converter={StaticResource NullToBool}}"
                            Padding="10,6" Margin="4,0,0,0"
                            Content="Devre dışı" />
                    <Button Grid.Column="5"
                            Command="{Binding DisableDebloatCommand}"
                            IsEnabled="{Binding SelectedDebloat, Converter={StaticResource NullToBool}}"
                            Padding="10,6" Margin="4,0,0,0"
                            Content="Kaldır (user 0)" />
                </Grid>

                <ListView Grid.Row="3"
                          ItemsSource="{Binding DebloatCandidates}"
                          SelectedItem="{Binding SelectedDebloat}"
                          VirtualizingPanel.IsVirtualizing="True">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Risk" Width="70" DisplayMemberBinding="{Binding RiskIcon}" />
                            <GridViewColumn Header="Seviye" Width="80" DisplayMemberBinding="{Binding RiskLabel}" />
                            <GridViewColumn Header="Uygulama" Width="160" DisplayMemberBinding="{Binding AppName}" />
                            <GridViewColumn Header="Paket" Width="240" DisplayMemberBinding="{Binding PackageName}" />
                            <GridViewColumn Header="Kategori" Width="120" DisplayMemberBinding="{Binding Category}" />
                            <GridViewColumn Header="Neden" Width="200" DisplayMemberBinding="{Binding Reason}" />
                            <GridViewColumn Header="Durum" Width="120" DisplayMemberBinding="{Binding StatusLabel}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <StatusBar Grid.Row="4">
                    <StatusBarItem>
                        <TextBlock Text="{Binding DebloatStatusMessage}" />
                    </StatusBarItem>
                    <StatusBarItem HorizontalAlignment="Right">
                        <ProgressBar Width="80" Height="4" IsIndeterminate="True"
                                     Visibility="{Binding IsDebloatLoading, Converter={StaticResource BoolToVis}}" />
                    </StatusBarItem>
                </StatusBar>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
