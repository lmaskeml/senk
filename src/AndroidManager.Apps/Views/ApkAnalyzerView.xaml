<UserControl x:Class="AndroidManager.Apps.Views.ApkAnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="960"
             Background="{DynamicResource Nexus.Background}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="APK Analyzer" Style="{StaticResource Nexus.Text.H1}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Nexus.Text.Caption}"
                           Foreground="{DynamicResource Nexus.TextSecondary}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource NexusCard}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Yerel APK" Style="{StaticResource Nexus.Text.H3}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding LocalApkPath, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" Margin="0,0,0,8" FontFamily="Consolas" FontSize="12" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Dosya seç" Command="{Binding PickApkCommand}"
                                Style="{StaticResource NexusSecondaryButton}" Margin="0,0,8,0" />
                        <Button Content="Analiz et" Command="{Binding AnalyzeLocalCommand}"
                                Style="{StaticResource NexusPrimaryButton}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Kurulu paket" Style="{StaticResource Nexus.Text.H3}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding PackageName, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" Margin="0,0,0,8" FontFamily="Consolas"
                             ToolTip="örn. com.android.chrome" />
                    <Button Content="Paketi analiz et" Command="{Binding AnalyzeInstalledCommand}"
                            Style="{StaticResource NexusPrimaryButton}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="1" Height="3" VerticalAlignment="Bottom" IsIndeterminate="True"
                     Foreground="{DynamicResource Nexus.Primary}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        <ScrollViewer Grid.Row="2" Style="{StaticResource NexusPageScroll}" Padding="0">
            <StackPanel>
                <Border Style="{StaticResource NexusCard}" Margin="0,0,0,12"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,10">
                            <TextBlock Text="Uygulama" Foreground="{DynamicResource Nexus.TextMuted}" FontSize="11" />
                            <TextBlock Text="{Binding Result.AppLabel}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Result.PackageName}" FontFamily="Consolas" FontSize="12"
                                       Foreground="{DynamicResource Nexus.TextSecondary}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,10">
                            <TextBlock Text="Sürüm" Foreground="{DynamicResource Nexus.TextMuted}" FontSize="11" />
                            <TextBlock FontSize="14">
                                <Run Text="{Binding Result.VersionName}" />
                                <Run Text=" (" />
                                <Run Text="{Binding Result.VersionCode}" />
                                <Run Text=")" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,0,10">
                            <TextBlock Text="Boyut" Foreground="{DynamicResource Nexus.TextMuted}" FontSize="11" />
                            <TextBlock Text="{Binding Result.ApkSizeFormatted}" FontSize="14" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                            <TextBlock Text="minSdk / targetSdk" Foreground="{DynamicResource Nexus.TextMuted}" FontSize="11" />
                            <TextBlock FontSize="14">
                                <Run Text="{Binding Result.MinSdk}" />
                                <Run Text=" / " />
                                <Run Text="{Binding Result.TargetSdk}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,10">
                            <TextBlock Text="Debuggable / RTL" Foreground="{DynamicResource Nexus.TextMuted}" FontSize="11" />
                            <TextBlock FontSize="14">
                                <Run Text="{Binding Result.IsDebuggable}" />
                                <Run Text=" / " />
                                <Run Text="{Binding Result.SupportsRtl}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                            <TextBlock Text="Kaynak" Foreground="{DynamicResource Nexus.TextMuted}" FontSize="11" />
                            <TextBlock Text="{Binding Result.Notes}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,0,0,10">
                            <TextBlock Text="Yol" Foreground="{DynamicResource Nexus.TextMuted}" FontSize="11" />
                            <TextBlock Text="{Binding Result.InstallLocation}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.ColumnSpan="3">
                            <TextBlock Text="İmza / Sertifika" Style="{StaticResource Nexus.Text.H3}" Margin="0,0,0,6" />
                            <TextBlock Foreground="{DynamicResource Nexus.TextMuted}" FontSize="11" Text="Şema" />
                            <TextBlock Text="{Binding Result.SigningScheme}" FontSize="13" Margin="0,0,0,6" />
                            <TextBlock Foreground="{DynamicResource Nexus.TextMuted}" FontSize="11" Text="Subject" />
                            <TextBlock Text="{Binding Result.SignerSubject}" FontFamily="Consolas" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock Foreground="{DynamicResource Nexus.TextMuted}" FontSize="11" Text="Issuer" />
                            <TextBlock Text="{Binding Result.CertificateIssuer}" FontFamily="Consolas" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock Foreground="{DynamicResource Nexus.TextMuted}" FontSize="11" Text="SHA-256" />
                            <TextBlock Text="{Binding Result.CertificateSha256}" FontFamily="Consolas" FontSize="11"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <UniformGrid Columns="2" Margin="0,0,0,12">
                    <DockPanel Margin="0,0,6,0">
                        <TextBlock DockPanel.Dock="Top" Text="İzinler" Style="{StaticResource Nexus.Text.H3}" Margin="0,0,0,6" />
                        <ListBox ItemsSource="{Binding Permissions}" Height="220" FontFamily="Consolas" FontSize="11"
                                 Background="{DynamicResource Nexus.Surface}"
                                 BorderBrush="{DynamicResource Nexus.Border}" />
                    </DockPanel>
                    <DockPanel Margin="6,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Activities" Style="{StaticResource Nexus.Text.H3}" Margin="0,0,0,6" />
                        <ListBox ItemsSource="{Binding Activities}" Height="220" FontFamily="Consolas" FontSize="11"
                                 Background="{DynamicResource Nexus.Surface}"
                                 BorderBrush="{DynamicResource Nexus.Border}" />
                    </DockPanel>
                </UniformGrid>

                <UniformGrid Columns="2" Margin="0,0,0,12">
                    <DockPanel Margin="0,0,6,0">
                        <TextBlock DockPanel.Dock="Top" Text="Services" Style="{StaticResource Nexus.Text.H3}" Margin="0,0,0,6" />
                        <ListBox ItemsSource="{Binding Services}" Height="160" FontFamily="Consolas" FontSize="11"
                                 Background="{DynamicResource Nexus.Surface}"
                                 BorderBrush="{DynamicResource Nexus.Border}" />
                    </DockPanel>
                    <DockPanel Margin="6,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Receivers" Style="{StaticResource Nexus.Text.H3}" Margin="0,0,0,6" />
                        <ListBox ItemsSource="{Binding Receivers}" Height="160" FontFamily="Consolas" FontSize="11"
                                 Background="{DynamicResource Nexus.Surface}"
                                 BorderBrush="{DynamicResource Nexus.Border}" />
                    </DockPanel>
                </UniformGrid>

                <UniformGrid Columns="2">
                    <DockPanel Margin="0,0,6,0">
                        <TextBlock DockPanel.Dock="Top" Text="Native ABI" Style="{StaticResource Nexus.Text.H3}" Margin="0,0,0,6" />
                        <ListBox ItemsSource="{Binding NativeLibs}" Height="120" FontFamily="Consolas" FontSize="11"
                                 Background="{DynamicResource Nexus.Surface}"
                                 BorderBrush="{DynamicResource Nexus.Border}" />
                    </DockPanel>
                    <DockPanel Margin="6,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="En büyük ZIP girdileri" Style="{StaticResource Nexus.Text.H3}" Margin="0,0,0,6" />
                        <ListView ItemsSource="{Binding LargestEntries}" Height="120"
                                  Background="{DynamicResource Nexus.Surface}"
                                  BorderBrush="{DynamicResource Nexus.Border}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Girdi" Width="220" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="Boyut" Width="80" DisplayMemberBinding="{Binding SizeFormatted}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
