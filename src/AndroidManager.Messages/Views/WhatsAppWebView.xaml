<UserControl x:Class="AndroidManager.Messages.Views.WhatsAppWebView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{DynamicResource Nexus.Background}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Nexus.Primary}"
                Padding="12,10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ZoomOutCommand}"
                            ToolTip="Küçült"
                            Padding="8,4" Margin="0,0,2,0"
                            Background="Transparent" BorderThickness="0" Foreground="White">
                        <md:PackIcon Kind="MagnifyMinus" />
                    </Button>
                    <TextBlock Text="{Binding ZoomFactor, StringFormat={}{0:P0}}"
                               Foreground="White" VerticalAlignment="Center"
                               FontSize="12" Margin="2,0,2,0" MinWidth="40"
                               TextAlignment="Center" />
                    <Button Command="{Binding ZoomInCommand}"
                            ToolTip="Büyüt"
                            Padding="8,4" Margin="0,0,8,0"
                            Background="Transparent" BorderThickness="0" Foreground="White">
                        <md:PackIcon Kind="MagnifyPlus" />
                    </Button>

                    <Button Command="{Binding ReloadCommand}"
                            Padding="10,4" Margin="0,0,6,0"
                            Background="Transparent" BorderThickness="0" Foreground="White"
                            ToolTip="Sayfayı yenile">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Refresh" Margin="0,0,4,0" />
                            <TextBlock Text="Yenile" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenInBrowserCommand}"
                            Padding="10,4" Margin="0,0,6,0"
                            Background="Transparent" BorderThickness="0" Foreground="White"
                            ToolTip="Tarayıcıda aç">
                        <md:PackIcon Kind="OpenInNew" />
                    </Button>
                    <Button Command="{Binding OpenCacheFolderCommand}"
                            Padding="10,4" Margin="0,0,6,0"
                            Background="Transparent" BorderThickness="0" Foreground="White"
                            ToolTip="Kalıcı oturum klasörü"
                            Content="Önbellek" />
                    <Button Command="{Binding ClearSessionCommand}"
                            Padding="10,4"
                            Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Nexus.Danger}"
                            ToolTip="QR oturumunu sil">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Logout" Margin="0,0,4,0" />
                            <TextBlock Text="Oturumu Sil" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="WhatsApp Web" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock FontSize="11" Foreground="White" Opacity="0.85" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="⭕ Oturum yok — QR ile bağlanın" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSession}" Value="True">
                                        <Setter Property="Text" Value="🟢 Kalıcı oturum aktif" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="WebView"
                          DefaultBackgroundColor="#F0F2F5" />

            <Border Background="{DynamicResource Nexus.Surface}" Opacity="0.85"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="4" Foreground="{DynamicResource Nexus.Success}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="0,12,0,0"
                               Foreground="{DynamicResource Nexus.TextSecondary}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding SessionInfo}" Foreground="{DynamicResource Nexus.TextSecondary}" FontSize="11" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
