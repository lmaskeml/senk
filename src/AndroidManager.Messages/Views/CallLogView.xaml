<UserControl x:Class="AndroidManager.Messages.Views.CallLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{DynamicResource Nexus.Background}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Nexus.SurfaceElevated}" BorderBrush="{DynamicResource Nexus.Border}" BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding ExportJsonCommand}" Style="{StaticResource NexusTertiaryButton}" Margin="0,0,6,0" ToolTip="JSON dışa aktar">
                        <TextBlock Text="JSON" VerticalAlignment="Center" />
                    </Button>
                    <Button Command="{Binding ExportCsvCommand}" Style="{StaticResource NexusTertiaryButton}" Margin="0,0,6,0" ToolTip="CSV dışa aktar">
                        <TextBlock Text="CSV" VerticalAlignment="Center" />
                    </Button>
                    <Button Command="{Binding ExportExcelCommand}" Style="{StaticResource NexusTertiaryButton}" Margin="0,0,6,0" ToolTip="Excel (.xls)">
                        <TextBlock Text="Excel" VerticalAlignment="Center" />
                    </Button>
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource NexusPrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Refresh" Margin="0,0,4,0" />
                            <TextBlock Text="Yenile" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Arama geçmişi" Style="{StaticResource Nexus.Text.H1}" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Nexus.TextSecondary}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="İsim veya numara ara"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         MaxWidth="480"
                         HorizontalAlignment="Left">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="1" Margin="8,0,0,0" Padding="10,0"
                        HorizontalAlignment="Left"
                        Command="{Binding SearchCommand}">
                    <md:PackIcon Kind="Magnify" />
                </Button>
            </Grid>

            <ListView Grid.Row="1"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedCall}"
                      BorderThickness="0"
                      Background="Transparent"
                      Margin="8,0,8,8">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="" Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DirectionGlyph}"
                                               FontSize="16" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Kişi" Width="220">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Number}" Foreground="{DynamicResource Nexus.TextMuted}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Tür" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding DirectionGlyph}" />
                                        <Run Text=" " />
                                        <Run Text="{Binding TypeLabel}" />
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Saat" Width="70"
                                        DisplayMemberBinding="{Binding TimeFormatted}" />
                        <GridViewColumn Header="Tarih" Width="100"
                                        DisplayMemberBinding="{Binding DateFormatted}" />
                        <GridViewColumn Header="Süre" Width="80"
                                        DisplayMemberBinding="{Binding DurationFormatted}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <Border Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource Nexus.Surface}" Opacity="0.7"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ProgressBar IsIndeterminate="True" Width="200" Height="4" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
